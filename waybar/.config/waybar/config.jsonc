[
  {
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "reload_style_on_change": true,
    // "margin-top": 8,
    // "margin-right": 10,
    // "margin-bottom": 0,
    // "margin-left": 10,
    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "modules-left": ["custom/apps", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["cava"],
    "modules-right": [
      "custom/music",
      "pulseaudio",
      // "custom/separator",
      "bluetooth",
      "network",
      "battery",
      "backlight",
      "custom/nightlight",
      "group/slide",
      "hyprland/language",
      "clock",
      "custom/mpvpaper",
      "custom/notifications",
      "custom/power",
    ],

    // MODULES LEFT
    "custom/apps": {
      "format": "",
      "tooltip": false,
      "on-click": "~/.config/scripts/app-launcher.sh",
    },
    "hyprland/workspaces": {
      "disable-scroll": false,
      "on-click": "activate",
      "expand": false,
      "format": " {icon}",
      "format-icons": {
        "default": "",
        "active": "",
      },
    },
    "hyprland/window": {
      "format": "{initialTitle}",
      "rewrite": {
        ".* - Brave": "Brave",
        ".* - Chromium": "Chromium",
        ".*LibreOffice (.*)": "LibreOffice $1",
        ".* Thunderbird": "Thunderbird",
        ".*WhatsApp Web.*": "WhatsApp",
      },
      "tooltip": false,
      "separate-outputs": true,
      "icon": true,
      "icon-size": 15,
      "max-length": 20,
    },

    // MODULES CENTER
    "cava": {
      "cava_config": "$XDG_CONFIG_HOME/cava/waybar_cava.conf",
      "input_delay": 2,
      "sleep_timer": 1,
      "hide_on_silence": true,
      "actions": {
        "on-click-right": "mode",
      },
    },

    // MODULES RIGHT
    "custom/music": {
      "format": "{}",
      "escape": true,
      "interval": 1,
      "tooltip-format": "{}",
      "exec": "~/.config/scripts/waybar-music.sh",
      "on-click": "~/.config/scripts/waybar-music.sh play-pause",
      "on-scroll-up": "~/.config/scripts/waybar-music.sh previous",
      "on-scroll-down": "~/.config/scripts/waybar-music.sh next",
      "on-click-right": "~/.config/scripts/waybar-music.sh switch",
      "max-length": 50,
    },
    "group/slide": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 500,
        "transition-left-to-right": false,
        "click-to-reveal": false,
      },
      "modules": ["custom/separator", "tray"],
    },
    "custom/separator": {
      "format": "",
      "tooltip": false,
    },
    "tray": {
      "icon-size": 13,
      "spacing": 24,
      "show-passive-items": true,
    },
    "backlight": {
      "device": "intel_backlight",
      "format": "{icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""],
      "tooltip-format": "{icon} {percent}%",
      // "scroll_step": 5,
      "disable-scroll": true,
    },
    "battery": {
      "states": {
        "info": 60,
        "warning": 40,
        "critical": 15,
      },
      "interval": 5,
      "format": "{icon}",
      "format-charging": "{icon}󱐋",
      "format-full": "󰂄",
      "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "tooltip-format": "{capacity}% | {power}W | {timeTo}",
    },
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "",
      "format-bluetooth": "󰂰  {icon}",
      "format-icons": {
        "headset": "",
        "headphones": "",
        "default": ["", "", ""],
      },
      // "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
      // "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
      "on-click": "hyprctl dispatch \"hl.dsp.exec_cmd('pavucontrol')\"",
      "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "tooltip": true,
      "tooltip-format": "{desc}: {volume}%",
      // "scroll-step": 5,
      "disable-scroll": true,
      "max-volume": 120,
    },
    "bluetooth": {
      "format-on": "󰂯",
      "format-off": "󰂯",
      "format-disabled": "󰂯",
      "format-connected": "󰂯",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "tooltip-format-on": "Bluetooth: on",
      "tooltip-format-off": "Bluetooth: off",
      "on-click": "hyprctl dispatch \"hl.dsp.exec_cmd('blueman-manager')\"",
      "on-click-right": "~/.config/scripts/toggle_bluetooth.sh",
    },
    "network": {
      "format-wifi": "{icon}",
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "format-ethernet": "󰈀",
      "format-linked": "󰌙",
      "format-unknown": "󰤫",
      "format-disconnected": "󰤭",
      "format-disabled": "",
      "on-click": "hyprctl dispatch \"hl.dsp.exec_cmd('nm-connection-editor')\"",
      "tooltip-format-wifi": "{essid}  󰖩 {signalStrength}%",
      "tooltip-format-ethernet": "{ifname} ",
      "tooltip-format-disconnected": "Disconnected",
      "tooltip-format-unknown": "Unknown",
      "interval": 2,
    },
    "hyprland/language": {
      "format": "{short}",
      "on-click": "~/.config/scripts/switch-layout.sh",
    },
    "custom/power": {
      "tooltip": true,
      "on-click": "~/.config/scripts/wlogout-dynamic.sh",
      "format": "",
      "tooltip-format": "Power Menu",
    },
    "custom/mpvpaper": {
      "exec-if": "which mpvpaper",
      "exec": "~/.config/scripts/mpvpaper-status.sh",
      "interval": 1,
      "on-click": "~/.config/scripts/live-wallpaper-picker.py",
      "on-click-middle": "~/.config/scripts/mpvpaper-stop.sh",
      "on-click-right": "~/.config/scripts/mpvpaper-toggle.sh",
      "return-type": "json",
      "tooltip": true,
    },
    "clock": {
      "format": "{:%H:%M}",
      // "format-alt": "{:%A %d %B %y - %R}",
      "tooltip-format": "<span font='JetBrainsMono Nerd Font'> {calendar} </span>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "on-click": "mode",
        "format": {
          "months": "{}",
          "days": "{}",
          "weeks": "W{}",
          "weekdays": "{}",
          "today": "<span color='#fab387'><b>{}</b></span>",
        },
      },
      "actions": {
        "on-click": "mode",
        // "on-click-forward": "tz_up",
        // "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down",
      },
    },
    "custom/notifications": {
      "tooltip": true,
      "format": "{icon}",
      "format-icons": {
        "notification": "󱅫",
        "none": "󰂚",
        "dnd-notification": "󰂠",
        "dnd-none": "󰂠",
        "inhibited-notification": "󱅫",
        "inhibited-none": "󰂚",
        "dnd-inhibited-notification": "󰂠",
        "dnd-inhibited-none": "󰂠",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
    },
    "custom/nightlight": {
      "exec-if": "which hyprsunset",
      "exec": "~/.config/scripts/nightlight-status.sh",
      "interval": 1,
      "on-click": "~/.config/scripts/nightlight-toggle.sh",
      "tooltip": true,
      "return-type": "json",
    },
  },
]
