#!/usr/bin/env bash
# Updates everything: with snapshots (a btrfs root, install.sh), first a snapshot of / to go
# back to from the boot menu (the newest 5 kept); then pacman and AUR packages (paru shows Arch news first), Flatpak apps, the
# Limine menu when Limine or the kernels changed, Neovim plugins and Mason tools, spicetify, and
# Hyprdori's new migrations (hyprdori-migrate). Then lists new .pacnew files and says when a
# reboot is needed.
#
#   hyprdori-update           all of it, asking before each package transaction
#   hyprdori-update --yes     no questions from paru, pacman or flatpak
#   hyprdori-update --window  in a window (hyprdori-present, the Control Center's update button):
#                             check for updates (listed, then asks to update), this, the boot
#                             menu and splash (hyprdori-theme-boot),
#                             maintenance (hyprdori-maintenance) or Spotify's theme
#                             (hyprdori-spicetify --force), then the output, and any key closes it
#   hyprdori-update --notify  count the updates waiting (repos, AUR, Flatpak; nothing installed) and,
#                             with any, a notification whose Update opens the window (the weekly
#                             timer, hyprdori-update-check.timer: Saturdays); the count is kept in
#                             ~/.local/state/hyprdori/updates-waiting for the shell's update button
#                             until the packages are updated

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
set -uo pipefail

hyprdori=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)
yes=false
[[ ${1:-} == --yes || ${1:-} == -y ]] && yes=true
bin="$hyprdori/bin/.local/bin"
# How many updates the last check found, for the shell's update button (its dot); gone when none
waiting=${XDG_STATE_HOME:-$HOME/.local/state}/hyprdori/updates-waiting

# The updates waiting, nothing installed and no password: their lists (repo_list, aur_list,
# flat_list) and counts (repo, aur, flat, total); the count kept for the shell's update button
# (gone when none). The weekly check and the window's "Check for updates" use it.
count_updates() {
    repo_list=$(checkupdates 2>/dev/null)
    aur_list=$(paru -Qua 2>/dev/null)
    flat_list=""
    command -v flatpak >/dev/null && flat_list=$(flatpak remote-ls --updates 2>/dev/null)
    repo=$(grep -c . <<<"$repo_list")
    aur=$(grep -c . <<<"$aur_list")
    flat=$(grep -c . <<<"$flat_list")
    total=$((repo + aur + flat))
    if ((total == 0)); then
        rm -f "$waiting"
    else
        mkdir -p "${waiting%/*}"
        echo "$total" >"$waiting"
    fi
}

# --- Waiting updates, for the weekly timer: counted, nothing installed; a notification with any.
# Waits up to an hour for the shell to take notifications (the timer can fire before login) ---
if [[ ${1:-} == --notify ]]; then
    count_updates
    ((total == 0)) && exit 0
    parts=()
    ((repo)) && parts+=("$repo from the repos")
    ((aur)) && parts+=("$aur from the AUR")
    ((flat)) && parts+=("$flat Flatpak")
    body=$(IFS=,; echo "${parts[*]}" | sed 's/,/, /g')
    gdbus wait --session --timeout 3600 org.freedesktop.Notifications >/dev/null 2>&1 || exit 0
    action=$(notify-send -a "System update" -i system-software-update -A update=Update \
        "$total updates available" "$body. Update opens the update window.")
    [[ $action == update ]] && exec "$(readlink -f "$0")" --window
    exit 0
fi

# --- In a window: what can be updated, the choice, then its output ---------------------------
if [[ ${1:-} == --window ]]; then
    exec "$bin/hyprdori-present" window hyprdori-window "Update" "$(readlink -f "$0")" --in-window
fi
if [[ ${1:-} == --in-window ]]; then
    "$bin/hyprdori-present" header
    "$bin/hyprdori-present" box "Check for updates: lists what can be updated (repos, AUR, Flatpak) without" \
        "installing anything or asking for your password, then asks whether to update all of it." \
        "" "Full system: packages (repos and AUR, with Arch news first), Flatpak apps," \
        "the boot menu when Limine or a kernel changed, Neovim's plugins, spicetify and" \
        "Hyprdori's migrations. It asks before each package transaction." \
        "" "Boot menu and splash: Limine's menu and the Plymouth splash in the current theme," \
        "logos and password field, and the login screen's layout." \
        "" "Maintenance: clean up what builds up (old packages in pacman's cache, AUR build" \
        "folders, orphaned packages, unused Flatpak runtimes, download caches, crash dumps, the" \
        "journal), each showing what it frees and asking first; then failed services and config" \
        "files to merge." \
        "" "Spotify's theme: Spotify in the theme's colors again (Spicetify), e.g. after Spotify" \
        "updated itself. Spotify has to be closed; no password needed." \
        "" "Updating, the boot menu and maintenance need your password (sudo). Keep the laptop on" \
        "power for a full update."
    check="Check for updates" full="Full system update" boot="Boot menu and splash" clean="Maintenance (clean up)" spotify="Spotify's theme"
    choice=$("$bin/hyprdori-present" choose "What to do?" "$check" "$full" "$boot" "$clean" "$spotify" "Cancel")
    status=0
    case $choice in
        "$check")
            "$bin/hyprdori-present" step "Checking for updates"
            # a spinner while it counts (hyprdori-present spin, until this pipe closes)
            exec 3> >("$bin/hyprdori-present" spin "Asking the repos, the AUR and Flatpak")
            spinner=$!
            count_updates
            exec 3>&-
            wait "$spinner"
            if ((total == 0)); then
                echo "  Everything is up to date."
            else
                ((repo)) && { echo "  From the repos ($repo):"; sed 's/^/    /' <<<"$repo_list"; }
                ((aur)) && { echo "  From the AUR ($aur):"; sed 's/^/    /' <<<"$aur_list"; }
                ((flat)) && { echo "  Flatpak ($flat):"; sed 's/^/    /' <<<"$flat_list"; }
                echo
                if "$bin/hyprdori-present" confirm "Update all $total now?"; then
                    "$(readlink -f "$0")" || status=$?
                else
                    echo "  Nothing updated."
                fi
            fi
            ;;
        "$full") "$(readlink -f "$0")" || status=$? ;;
        "$boot") "$bin/hyprdori-present" step "Boot screens"; "$bin/hyprdori-theme-boot" --force || status=$? ;;
        "$clean") "$bin/hyprdori-maintenance" || status=$? ;;
        "$spotify")
            "$bin/hyprdori-present" step "Spotify's theme"
            if pgrep -x spotify >/dev/null; then
                echo "  Spotify is open: close it, then choose this again."
                status=1
            else
                "$bin/hyprdori-spicetify" --force || status=$?
            fi
            ;;
        *) echo "  Nothing updated." ;;
    esac
    "$bin/hyprdori-present" done "$status"
    exit "$status"
fi

step() { "$bin/hyprdori-present" step "$1"; }
note() { printf '\e[33m%s\e[0m\n' "$1"; }

# Awake while it runs (on battery it asks first), then the password once: sudo keeps it until the
# update ends, however long the downloads and builds take
"$bin/hyprdori-awake" $$ "the update" || { echo "Nothing updated."; exit 0; }
export HYPRDORI_AWAKE_ASKED=1
"$bin/hyprdori-sudo-hold" $$ || { echo "No password, nothing updated."; exit 1; }

# --- A snapshot of / first (snapper's root config, install.sh on a btrfs root): one per update,
# the newest 5 kept (cleaned up at once); limine-snapper-sync puts it in the boot menu. /home
# isn't in it: work in the home folders is never rolled back ------------------------------------
if command -v snapper >/dev/null && sudo snapper list-configs 2>/dev/null | grep -q '^root '; then
    step "Snapshot"
    # with a spinner (sudo has the password: hyprdori-sudo-hold above)
    if "$bin/hyprdori-present" spin "Taking a snapshot of /" \
        sudo -n snapper -c root create -c number -d "Before update $(date '+%F %H:%M')"; then
        "$bin/hyprdori-present" spin "Removing the oldest beyond 5" sudo -n snapper -c root cleanup number
        echo "Taken; the boot menu's Snapshots has it."
    else
        note "No snapshot taken; the update goes on."
    fi
fi

# --- System packages (repos, the g14 repo, AUR) ---------------------------------------------
step "Packages"
if $yes; then
    paru -Syu --noconfirm
else
    paru -Syu
fi && rm -f "$waiting" || note "The package upgrade didn't finish; the steps below still run."

# --- Flatpak --------------------------------------------------------------------------------
if command -v flatpak >/dev/null; then
    step "Flatpak"
    # The app catalogue first, with a spinner: on a slow connection it takes a while and prints
    # nothing meanwhile. Then the apps, which ask before changing anything (not with --yes); the
    # catalogue they check again is the one just fetched
    "$bin/hyprdori-present" spin "Refreshing Flathub's app catalogue (appstream data)" flatpak update --appstream
    if $yes; then flatpak update -y; else flatpak update; fi
fi

# --- Limine: its EFI file and menu entries follow the package and the kernels in /efi/arch ---
# the menu: /efi/limine.conf, or where it was before snapshots (EFI/limine)
conf=/efi/limine.conf
[[ -r $conf ]] || conf=/efi/EFI/limine/limine.conf
if [[ -r $conf ]]; then
    step "Limine"
    reasons=()
    cmp -s /usr/share/limine/BOOTX64.EFI /efi/EFI/limine/BOOTX64.EFI || reasons+=("a new Limine")
    # the kernel entries (//name), not the Snapshots folder or the snapshots in it (///...)
    in_menu=$(sed -n 's|^//\([^/]\)|\1|p' "$conf" | grep -vx Snapshots | sort | tr '\n' ' ')
    on_esp=$(for k in /efi/arch/vmlinuz-*; do [[ -e /efi/arch/initramfs-${k#*/vmlinuz-}.img ]] && echo "${k#*/vmlinuz-}"; done | sort | tr '\n' ' ')
    [[ $in_menu == "$on_esp" ]] || reasons+=("kernels changed: ${on_esp:-none}")
    if ((${#reasons[@]})); then
        echo "Rewriting the menu (${reasons[*]})"
        read -ra options <<<"$(sed -n 's/^# Options: //p' "$conf")"
        sudo "$hyprdori/limine/install.sh" "${options[@]}"
    else
        echo "Up to date."
    fi
fi

# --- Neovim: plugins, then Mason's tools -----------------------------------------------------
if command -v nvim >/dev/null; then
    step "Neovim plugins"
    # One machine updates the plugins and commits lazy-lock.json (marked by
    # ~/.config/hyprdori/plugin-updates); the others install the committed versions and leave the
    # file as it is, so pulling never clashes on it
    if [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/hyprdori/plugin-updates ]]; then
        "$bin/hyprdori-present" spin "Installing, updating and cleaning them (Lazy sync)" \
            bash -c 'nvim --headless "+Lazy! sync" +qa 2>&1 | tail -n 3'
        echo "  lazy-lock.json has the new versions, to commit"
    else
        "$bin/hyprdori-present" spin "Installing lazy-lock.json's versions (Lazy restore, then clean)" \
            bash -c 'nvim --headless "+Lazy! restore" "+Lazy! clean" +qa 2>&1 | tail -n 3'
    fi
    step "Mason tools"
    mason=$(mktemp --suffix=.lua)
    cat >"$mason" <<'EOF'
pcall(function() require("lazy").load({ plugins = { "mason.nvim" } }) end)
local ok, registry = pcall(require, "mason-registry")
if not ok then io.write("Mason isn't set up.\n") vim.cmd("qa!") return end
local refreshed = false
registry.refresh(function() refreshed = true end)
vim.wait(120000, function() return refreshed end, 200)
local pending, failed = 0, {}
for _, pkg in ipairs(registry.get_installed_packages()) do
  local okc, current = pcall(pkg.get_installed_version, pkg)
  local okl, latest = pcall(pkg.get_latest_version, pkg)
  if okc and okl and current and latest and current ~= latest then
    pending = pending + 1
    io.write(("%s %s -> %s\n"):format(pkg.name, current, latest))
    pkg:install({ version = latest }, function(success)
      if not success then table.insert(failed, pkg.name) end
      pending = pending - 1
    end)
  end
end
vim.wait(900000, function() return pending == 0 end, 500)
if #failed > 0 then io.write("Failed: " .. table.concat(failed, ", ") .. "\n")
elseif pending == 0 then io.write("Up to date.\n") end
vim.cmd("qa!")
EOF
    nvim --headless -c "luafile $mason"
    rm -f "$mason"
fi

# --- spicetify: Spotify updates itself on launch, which undoes the theme -------------------
if command -v spicetify >/dev/null && "$bin/hyprdori-spicetify" --check; then
    step "spicetify"
    if pgrep -x spotify >/dev/null; then
        note "Spotify is open: close it, then run hyprdori-spicetify --force to style it again."
    elif "$bin/hyprdori-present" spin "Styling Spotify" bash -c '"$1" --force >/dev/null' _ "$bin/hyprdori-spicetify"; then
        echo "Spotify styled again (the theme's colors)."
    else
        note "Spotify couldn't be styled; run hyprdori-spicetify --force to see why."
    fi
fi

# --- Hyprdori's one-time changes since the last update --------------------------------------
# --- Links: the repo's folders stowed again, as install.sh does, so files added to them since
# this machine was installed get their links and removed ones lose theirs. With a file in the
# way stow changes nothing; it's listed to move aside, and the next update links the rest ------
step "Links"
not_stowed=(limine migrations packages plymouth sddm)   # the same as install.sh's
stowed=()
for dir in "$hyprdori"/*/; do
    name=$(basename "$dir")
    [[ " ${not_stowed[*]} " == *" $name "* ]] || stowed+=("$name")
done
# a folder systemd writes into itself stays a real one (as install.sh makes it)
mkdir -p "$HOME/.local/share/systemd/user"
if out=$(stow -v -d "$hyprdori" -t "$HOME" --restow "${stowed[@]}" 2>&1); then
    # re-made links say "(reverts previous action)": only the others are new or gone
    changes=$(printf '%s\n' "$out" | awk '
        /^LINK: / && !/reverts previous action/ { sub(/ =>.*/, ""); print "  linked   ~/" substr($0, 7); next }
        /^UNLINK: / { u[substr($0, 9)] = 1 }
        /^LINK: .*reverts previous action/ { l = $0; sub(/^LINK: /, "", l); sub(/ =>.*/, "", l); delete u[l] }
        END { for (f in u) print "  unlinked ~/" f }')
    if [[ -n $changes ]]; then printf '%s\n' "$changes"; else echo "Up to date."; fi
else
    printf '%s\n' "$out" | grep -iE "existing target|conflict|cannot" | sed 's/^/  /'
    note "Nothing was linked: files are in the way (above). Move them aside, then update again."
fi

step "Migrations"
"$hyprdori/bin/.local/bin/hyprdori-migrate" || note "A migration failed; hyprdori-update tries it again."

# --- What's left to do by hand ----------------------------------------------------------------
step "Done"
mapfile -t pacnew < <(pacdiff -o 2>/dev/null)
if ((${#pacnew[@]})); then
    note "${#pacnew[@]} config file(s) have a new version to merge (.pacnew/.pacsave):"
    printf '  %s\n' "${pacnew[@]}"
    note "Merge them with: sudo DIFFPROG='nvim -d' pacdiff"
fi
if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
    note "The running kernel ($(uname -r)) was updated: reboot to use the new one."
fi
