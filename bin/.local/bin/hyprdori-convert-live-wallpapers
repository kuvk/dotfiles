#!/usr/bin/env python3
"""Lighter copies of videos for live wallpapers (ffmpeg, H.264): each video in
~/.local/share/hyprdori/backgrounds/live/source (the wallpaper picker skips that folder) into
~/.local/share/hyprdori/backgrounds/live, 2560 px wide at 30 fps. Settings by environment:
LIVE_WALLPAPER_SRC and LIVE_WALLPAPER_OUT (the folders), TARGET_W, TARGET_FPS, CRF, PRESET.

  hyprdori-convert-live-wallpapers
"""
import os
import sys
import subprocess
from pathlib import Path

HOME = Path(os.path.expanduser("~"))

# Originals go in ~/.local/share/hyprdori/backgrounds/live/source (the picker skips that folder)
LIVE_DIR = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "hyprdori/backgrounds/live"
SRC_DIR = Path(os.environ.get("LIVE_WALLPAPER_SRC", str(LIVE_DIR / "source"))).expanduser()
OUT_DIR = Path(os.environ.get("LIVE_WALLPAPER_OUT", str(LIVE_DIR))).expanduser()

TARGET_W = int(os.environ.get("TARGET_W", "2560"))
TARGET_FPS = int(os.environ.get("TARGET_FPS", "30"))

CRF = os.environ.get("CRF", "20")
PRESET = os.environ.get("PRESET", "veryfast")

EXTS = {".mp4", ".webm", ".mkv", ".mov"}

def convert_one(src: Path, dst: Path) -> None:
    dst.parent.mkdir(parents=True, exist_ok=True)

    vf = f"scale={TARGET_W}:-2,fps={TARGET_FPS}"

    cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error",
        "-y",
        "-i",
        str(src),
        "-an",
        "-vf",
        vf,
        "-c:v",
        "libx264",
        "-preset",
        PRESET,
        "-crf",
        CRF,
        "-pix_fmt",
        "yuv420p",
        str(dst.with_suffix(".mp4")),
    ]
    subprocess.run(cmd, check=False)

def main() -> int:
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if not SRC_DIR.exists():
        print(f"Source dir does not exist: {SRC_DIR}")
        return 1

    videos = [p for p in SRC_DIR.rglob("*") if p.is_file() and p.suffix.lower() in EXTS]
    videos.sort()

    if not videos:
        print(f"No videos found in: {SRC_DIR}")
        return 0

    for src in videos:
        rel = src.relative_to(SRC_DIR)
        out = OUT_DIR / rel
        print(f"Converting: {rel}")
        convert_one(src, out)

    print(f"Done. Output in: {OUT_DIR}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
