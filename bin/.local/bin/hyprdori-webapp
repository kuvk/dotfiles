#!/usr/bin/env python3
"""Web apps: a site in its own browser window (no tabs, no
address bar, no extension icons) with a launcher entry and an icon, so it
shows up in the search launcher and the app menu (Internet).

  hyprdori-webapp                                  ask for name, URL and icon
  hyprdori-webapp --window                         a window (Manage WebApps: the Control Center,
                                                   the app launcher): list them, install (the
                                                   browser, then name, URL and icon for as many
                                                   as needed) or uninstall, until Close
  hyprdori-webapp install NAME URL [ICON] [--browser B]   create (or update) a web app
  hyprdori-webapp list                             installed web apps
  hyprdori-webapp remove NAME                      remove one
  hyprdori-webapp launch [--browser B] URL         open URL as a web app (used by the entries)

B is a Chromium-based browser's command (brave, chromium, google-chrome-stable,
vivaldi-stable); without it, the first of those installed.

ICON is optional: a PNG URL, a local image file, or a name from
https://dashboardicons.com (e.g. "whatsapp"). Without one, the app's name is
tried on dashboardicons.com, then the site's favicon.

For no title bar at all, turn on Brave > Settings > Appearance > "Use system
title bar and borders" (Hyprland draws none).
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
APPS_DIR = DATA / "applications"
ICON_DIR = DATA / "icons/hicolor/256x256/apps"
PREFIX = "webapp-"
# what the entries run: the command, wherever Hyprdori is
SELF = Path.home() / ".local/bin/hyprdori-webapp"

DASHBOARD_ICONS = "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/{}.png"
FAVICON = "https://www.google.com/s2/favicons?domain={}&sz=256"
BROWSERS = ["brave", "brave-browser", "chromium", "google-chrome-stable", "vivaldi-stable"]


def slug(name: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def normalize_url(url: str) -> str:
    url = url.strip()
    if not re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", url):
        url = "https://" + url
    if not re.match(r"^https?://", url, re.I) or re.search(r"\s", url):
        raise SystemExit(f"Not a web address: {url}")
    return url


def installed_browsers() -> list[str]:
    """The Chromium-based browsers installed (web apps need --app), one command per browser."""
    found = [b for b in BROWSERS if shutil.which(b)]
    return [b for b in found if not (b == "brave-browser" and "brave" in found)]


def browser(preferred: str | None = None) -> str:
    if preferred:
        if preferred not in BROWSERS or not shutil.which(preferred):
            raise SystemExit(f"Not an installed Chromium-based browser: {preferred} ({', '.join(installed_browsers()) or 'none'})")
        return preferred
    for b in installed_browsers():
        return b
    raise SystemExit("Web apps need a Chromium-based browser (Brave, Chromium, Chrome)")


def download(url: str, dest: Path) -> bool:
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = resp.read()
    except OSError:
        return False
    # PNG, JPEG, WebP, ICO or SVG
    if not data or not (data[:8] == b"\x89PNG\r\n\x1a\n" or data[:3] == b"\xff\xd8\xff"
                        or data[8:12] == b"WEBP" or data[:4] == b"\x00\x00\x01\x00" or b"<svg" in data[:512]):
        return False
    dest.write_bytes(data)
    return True


def fetch_icon(name: str, url: str, icon: str | None) -> Path | None:
    """The icon as a 256 px PNG in the user's hicolor theme."""
    ICON_DIR.mkdir(parents=True, exist_ok=True)
    target = ICON_DIR / f"{PREFIX}{slug(name)}.png"
    with tempfile.TemporaryDirectory() as tmp:
        raw = Path(tmp) / "icon"
        candidates: list[str] = []
        if icon:
            if Path(icon).expanduser().is_file():
                shutil.copy(Path(icon).expanduser(), raw)
            elif re.match(r"^https?://", icon):
                candidates.append(icon)
            else:
                candidates.append(DASHBOARD_ICONS.format(slug(icon)))
        candidates.append(DASHBOARD_ICONS.format(slug(name)))
        candidates.append(FAVICON.format(urllib.parse.urlparse(url).netloc))
        if not raw.exists():
            for c in candidates:
                if download(c, raw):
                    print(f"Icon: {c}")
                    break
            else:
                return None
        magick = shutil.which("magick") or shutil.which("convert")
        if magick:
            done = subprocess.run([magick, f"{raw}[0]", "-background", "none", "-resize", "256x256",
                                   "-gravity", "center", "-extent", "256x256", f"png:{target}"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if not done:
                return None
        else:
            shutil.copy(raw, target)
    subprocess.run(["gtk-update-icon-cache", "-q", str(DATA / "icons/hicolor")],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return target


def window_class(b: str, url: str) -> str:
    """Chromium-based browsers name --app windows <prefix>-<host><path, / as _>-Default: Brave
    "brave", Chromium and Chrome "chrome"."""
    parts = urllib.parse.urlparse(url)
    path = (parts.path or "/").replace("/", "_")
    base = {"brave-browser": "brave", "google-chrome-stable": "chrome", "chromium": "chrome"}.get(b, b)
    return f"{base}-{parts.netloc}_{path}-Default"


def install(name: str, url: str, icon: str | None, preferred: str | None = None) -> None:
    if "/" in name or not slug(name):
        raise SystemExit(f"Not a usable app name: {name!r}")
    url = normalize_url(url)
    b = browser(preferred)
    icon_path = fetch_icon(name, url, icon)
    if icon_path is None:
        print("No icon found; the entry uses a generic web icon")
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    entry = APPS_DIR / f"{PREFIX}{slug(name)}.desktop"
    entry.write_text(
        "[Desktop Entry]\n"
        "Version=1.0\n"
        "Type=Application\n"
        f"Name={name}\n"
        f"Comment=Web app: {url}\n"
        f'Exec="{SELF}" launch --browser {b} {url}\n'
        # full path: Quickshell (Qt) doesn't see icons added to the theme
        # after it started; GTK apps find it in the hicolor theme too
        f"Icon={icon_path if icon_path else 'web-browser'}\n"
        "Terminal=false\n"
        "Categories=Network;WebBrowser;\n"
        f"StartupWMClass={window_class(b, url)}\n"
        f"X-WebApp-URL={url}\n"
        f"X-WebApp-Browser={b}\n"
    )
    entry.chmod(0o755)
    print(f"Installed {name}: {entry}")


def installed() -> list[tuple[str, str, Path]]:
    apps = []
    for entry in sorted(APPS_DIR.glob(f"{PREFIX}*.desktop")):
        text = entry.read_text()
        name = re.search(r"^Name=(.*)$", text, re.M)
        url = re.search(r"^X-WebApp-URL=(.*)$", text, re.M)
        apps.append((name.group(1) if name else entry.stem, url.group(1) if url else "", entry))
    return apps


def remove(name: str) -> None:
    for app_name, _, entry in installed():
        if app_name.lower() == name.lower() or entry.stem == f"{PREFIX}{slug(name)}":
            entry.unlink()
            (ICON_DIR / f"{entry.stem}.png").unlink(missing_ok=True)
            print(f"Removed {app_name}")
            return
    raise SystemExit(f"No web app named {name!r} (see: hyprdori-webapp list)")


def launch(url: str, preferred: str | None = None) -> None:
    # the entry's browser, or the first installed if that one's gone
    b = browser(preferred) if preferred and shutil.which(preferred) else browser()
    # own session: the window outlives whatever started it
    subprocess.Popen([b, f"--app={normalize_url(url)}"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ask() -> None:
    try:
        name = input("Name: ").strip()
        url = input("URL: ").strip()
        icon = input("Icon (PNG URL, file, or dashboardicons.com name; empty: find one): ").strip() or None
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if name and url:
        install(name, url, icon)


PRESENT = HOME / ".local/bin/hyprdori-present"


def present(*args: str, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run([str(PRESENT), *args], text=True, stdout=subprocess.PIPE if capture else None)


def busy(title: str, work):
    """work() with hyprdori-present's spinner and TITLE beside it (spin, until its input closes);
    what it prints, its commands' output too, held back and shown after it's done."""
    sys.stdout.flush()
    sys.stderr.flush()
    spinner = subprocess.Popen([str(PRESENT), "spin", title], stdin=subprocess.PIPE)
    saved = os.dup(1), os.dup(2)
    with tempfile.TemporaryFile() as out:
        os.dup2(out.fileno(), 1)
        os.dup2(out.fileno(), 2)
        try:
            return work()
        finally:
            sys.stdout.flush()
            sys.stderr.flush()
            os.dup2(saved[0], 1)
            os.dup2(saved[1], 2)
            os.close(saved[0])
            os.close(saved[1])
            spinner.stdin.close()
            spinner.wait()
            out.seek(0)
            sys.stdout.buffer.write(out.read())
            sys.stdout.flush()


def install_some() -> int:
    """The browser, then name, address and icon for as many apps as wanted."""
    browsers = installed_browsers()
    if not browsers:
        print("  Web apps need a Chromium-based browser (Brave, Chromium, Chrome or Vivaldi).")
        return 1
    b = browsers[0] if len(browsers) == 1 else present("choose", "Browser", *browsers, capture=True).stdout.strip()
    status = 0
    while b:
        name = present("input", "Name", "e.g. WhatsApp", capture=True).stdout.strip()
        url = name and present("input", "Web address", "e.g. web.whatsapp.com", capture=True).stdout.strip()
        if not url:
            break
        icon = present("input", "Icon (empty: find one)", "PNG address, image file or dashboardicons.com name",
                       capture=True).stdout.strip() or None
        present("step", f"{name} in {b}")
        try:
            busy("Fetching its icon and adding it", lambda: install(name, url, icon, b))
        except SystemExit as e:
            print(f"  {e}")
            status = 1
        if present("confirm", "Install another?").returncode != 0:
            break
    return status


def list_apps() -> None:
    apps = installed()
    if not apps:
        print("  No web apps yet.")
        return
    width = max(len(name) for name, _, _ in apps)
    for name, url, entry in apps:
        browser_name = re.search(r"^X-WebApp-Browser=(.*)$", entry.read_text(), re.M)
        print(f"  {name:<{width}}  {url}  ({browser_name.group(1) if browser_name else 'the first browser found'})")


def uninstall_some() -> int:
    """One of the installed apps, asked for and then removed, as long as wanted."""
    while True:
        apps = installed()
        if not apps:
            print("  No web apps to remove.")
            return 0
        name = present("choose", "Remove which?", *[n for n, _, _ in apps], "Back", capture=True).stdout.strip()
        if not name or name == "Back":
            return 0
        if present("confirm", f"Remove {name} (its entry and icon)?").returncode == 0:
            try:
                remove(name)
            except SystemExit as e:
                print(f"  {e}")
                return 1


def in_window() -> int:
    """The window: what a web app is, then list, install or uninstall, until Close."""
    present("header")
    present("box", "A web app is a site in its own window: no tabs, no address bar, no extension",
            "icons, with an entry and an icon in the app launcher and the app menu (Internet).", "",
            "List them, install new ones (the browser they open in, then a name and a web address",
            "for each; the icon is found by the app's name on dashboardicons.com or is the site's",
            "own, or give one), or uninstall them (their entry and icon go).")
    status = 0
    actions = {"List web apps": lambda: list_apps() or 0, "Install": install_some, "Uninstall": uninstall_some}
    while True:
        choice = present("choose", "What to do?", *actions, "Close", capture=True).stdout.strip()
        if not choice or choice == "Close":
            break
        present("step", choice)
        status = actions[choice]() or status
    present("done", str(status))
    return status


def main(argv: list[str]) -> int:
    if argv[:1] == ["--window"]:
        os.execv(str(PRESENT), [str(PRESENT), "window", "hyprdori-window", "Manage WebApps", str(SELF), "--in-window"])
    if argv[:1] == ["--in-window"]:
        return in_window()
    preferred = None
    if "--browser" in argv:
        i = argv.index("--browser")
        if i + 1 >= len(argv):
            print("--browser needs a browser's command", file=sys.stderr)
            return 1
        preferred = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    if not argv:
        ask()
    elif argv[0] in ("-h", "--help"):
        print(__doc__.strip())
    elif argv[0] == "install" and len(argv) in (3, 4):
        install(argv[1], argv[2], argv[3] if len(argv) == 4 else None, preferred)
    elif argv[0] == "list":
        for name, url, _ in installed():
            print(f"{name}\t{url}")
    elif argv[0] == "remove" and len(argv) == 2:
        remove(argv[1])
    elif argv[0] == "launch" and len(argv) == 2:
        launch(argv[1], preferred)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
