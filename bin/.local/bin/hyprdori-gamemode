#!/usr/bin/env bash
# Work-Game has two modes on top of normal:
#   Work  no animations, blur or rounding; Quickshell goes opaque with the Work-Game gaps,
#         and live wallpapers pause
#   Game  the same, plus a plain US keyboard (Alt and Super not swapped, as input.lua
#         does, and no layout switching) so games get the printed keys, and Stay Awake
#
#   hyprdori-gamemode work     Work mode, or back to normal if already in it (SUPER+G)
#   hyprdori-gamemode game     Game mode, or back to normal if already in it (SUPER+CTRL+G)
#   hyprdori-gamemode cycle    normal, Work, Game, normal (the bar and Control Center)
#   hyprdori-gamemode normal   leave either mode
#   hyprdori-gamemode restyle  the mode's look again (the shell runs it after Hyprland
#                             reloads its config, which brings back the normal look)
#
# /tmp/hypr-gamemode holds the mode; it exists in both, as other scripts only check that.
set -euo pipefail

FLAG="/tmp/hypr-gamemode"

HYPR_MON="$HOME/.local/bin/hyprdori-monitors"

# Keyboard: the usual layouts and options, read from input.lua, and Work-Game's
INPUT="$HOME/.config/hypr/configs/input.lua"
KB_LAYOUT=$(sed -n 's/^ *kb_layout = "\([^"]*\)".*/\1/p' "$INPUT" | head -n1)
KB_OPTIONS=$(sed -n 's/^ *kb_options = "\([^"]*\)".*/\1/p' "$INPUT" | head -n1)
GAME_KB_LAYOUT="us"
GAME_KB_OPTIONS="ctrl:nocaps"

# Border colors follow the current theme (its generated theme.lua, as general.lua reads it)
borders="package.loaded['configs.generated.theme'] = nil
local ok, theme = pcall(require, 'configs.generated.theme')
local borders = ok and { active_border = theme.active_border, inactive_border = theme.inactive_border } or nil"

# notify TITLE [BODY]
notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    # the body is a key hint: the shell shows it smaller (x-hyprdori.hint)
    notify-send -a "Work-Game" -i input-gaming -c x-hyprdori.hint "$@"
}

current_mode() {
    if [[ -e $FLAG ]]; then
        local mode
        mode=$(<"$FLAG")
        echo "${mode:-work}"
    else
        echo normal
    fi
}

style_on() {
    # every window opaque: there's no blur behind them
    hyprctl eval "$borders
hl.config({
    animations = { enabled = false },
    decoration = {
        blur = { enabled = false },
        active_opacity = 1,
        inactive_opacity = 1,
        rounding = 0,
    },
    general = {
        border_size = 2,
        col = borders,
    },
})
" || true
    "$HOME/.local/bin/hyprdori-wallpaper" pause on 2>/dev/null || true
}

style_off() {
    # decoration.lua again (opacity, blur), so its values live in one place; the
    # shell then sets the corners and blur from Settings (services/Hypr.qml)
    hyprctl eval "$borders
package.loaded['configs.decoration'] = nil
require('configs.decoration')
hl.config({
    animations = { enabled = true },
    general = {
        border_size = 2,
        col = borders,
    },
})
" || true
    "$HOME/.local/bin/hyprdori-wallpaper" pause off 2>/dev/null || true
}

keyboard() {
    hyprctl eval "hl.config({ input = { kb_layout = '$1', kb_options = '$2' } })" >/dev/null
}

set_mode() {
    local target=$1 current
    current=$(current_mode)
    [[ $target == "$current" ]] && return

    if [[ $target == normal ]]; then
        style_off
    elif [[ $current == normal ]]; then
        style_on
    fi
    if [[ $target == game ]]; then
        keyboard "$GAME_KB_LAYOUT" "$GAME_KB_OPTIONS"
    elif [[ $current == game ]]; then
        keyboard "$KB_LAYOUT" "$KB_OPTIONS"
    fi

    if [[ $target == normal ]]; then
        rm -f "$FLAG"
    else
        echo "$target" >"$FLAG"
    fi
    # Quickshell's look, gaps and Stay Awake
    qs ipc call theme mode "$target" >/dev/null 2>&1 || true

    case $target in
        work) notify "Work mode is ON" "SUPER+CTRL+G switches to Game mode." ;;
        game) notify "Game mode is ON" "SUPER+G switches to Work mode." ;;
        normal) notify "Work-Game is OFF" ;;
    esac
}

mode=$(current_mode)
case ${1:-work} in
    work) [[ $mode == work ]] && set_mode normal || set_mode work ;;
    game) [[ $mode == game ]] && set_mode normal || set_mode game ;;
    cycle)
        case $mode in
            normal) set_mode work ;;
            work) set_mode game ;;
            *) set_mode normal ;;
        esac
        ;;
    normal) set_mode normal ;;
    restyle) [[ $mode == normal ]] || style_on ;;
    *)
        echo "usage: hyprdori-gamemode [work|game|cycle|normal|restyle]" >&2
        exit 1
        ;;
esac
