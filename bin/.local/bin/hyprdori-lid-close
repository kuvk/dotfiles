#!/bin/bash
# The lid closed (bindings.lua): lock at once, unless an external monitor is connected, which
# makes it a docked laptop still in use (logind doesn't suspend then either): then the laptop's
# screen goes off instead (clamshell, hyprdori-monitors lid). Locking here gives the lock a head
# start on logind's suspend; hyprdori-sleep-lock then finds it secure. After Omarchy's
# omarchy-system-lid-close (github.com/basecamp/omarchy, MIT).

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
for connector in /sys/class/drm/card*-*; do
    name=${connector##*/}
    name=${name#card*-}
    [[ $name =~ ^(eDP|LVDS|DSI)- ]] && continue
    [[ $(cat "$connector/status" 2>/dev/null) == connected ]] && exec "$HOME/.local/bin/hyprdori-monitors" lid
done
qs ipc call lock lock
