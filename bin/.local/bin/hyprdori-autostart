#!/bin/bash
# What else starts at login (autostart.lua runs this once): clipboard history, the snapshot
# notifications, Spotify's theme setup (hyprdori-spicetify) and ROG Control Center when
# installed; more can be added below. Running it again would start them twice.
#
#   hyprdori-autostart

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac

# # OBS
# if command -v obs >/dev/null; then
#     obs --minimize-to-tray &
# fi

# # RGB
# if command -v openrgb >/dev/null; then
#     openrgb --startminimized -p vuk &
# fi

# Clipboard history (SUPER+SHIFT+V), kept in RAM so a reboot wipes it. Skipped if
# someone else owns the folder. To keep it across reboots, delete ~/.config/cliphist/config
# and these lines up to the watchers.
if command -v cliphist >/dev/null; then
    clipboard_dir=/tmp/cliphist-$UID
    mkdir -p -m 700 "$clipboard_dir"
    if [[ -O $clipboard_dir ]]; then
        mkdir -p "$HOME/.config/cliphist"
        printf 'db-path %s/db\n' "$clipboard_dir" >"$HOME/.config/cliphist/config"
        wl-paste --type text --watch cliphist store &
        wl-paste --type image --watch cliphist store &
    fi
fi

# Snapshots (limine-snapper-sync; Hyprland doesn't run its autostart entries): after booting a
# snapshot from the boot menu, an offer to restore it; and a notification when syncing the
# menu's snapshots fails (it follows the journal's errors, idle otherwise)
if command -v limine-snapper-restore >/dev/null; then
    limine-snapper-restore --notify &
    limine-snapper-notify &
fi

# Spotify in the theme's colors: set up once Spotify has run with an account logged in (a few file
# checks, then nothing once done)
command -v spicetify >/dev/null && "$HOME/.local/bin/hyprdori-spicetify" &

# In a virtual machine: the clipboard shared with the host (virt-manager's Spice). The agent
# speaks X11 only, so it works through Xwayland, whose clipboard Hyprland shares with Wayland apps:
# text both ways. Its daemon starts by itself when the VM's Spice channel is there.
if command -v spice-vdagent >/dev/null && systemd-detect-virt --vm --quiet 2>/dev/null; then
    GDK_BACKEND=x11 spice-vdagent
fi

# ROG Control Center
if command -v rog-control-center >/dev/null; then
    sleep 5 && rog-control-center --background --autostart &
fi
