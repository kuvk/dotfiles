#!/usr/bin/env python3
"""Draws a text logo (by default ~/.config/theme/logo/dori-logo) to a transparent PNG the way kitty
draws it in a terminal: every character on a grid of cells as kitty's (JetBrains Mono's: 45.5%
as wide as tall), braille as 2x4 dots, block characters (▄ ▌ ▙ ...) as exact rectangles and
Nerd Font's triangles (◢ ◣ ◤ ◥, U+E0B8 to U+E0BE) as exact triangles filling their cell. Font glyphs
for these don't fit the cell exactly, so text renderers leave seams and overlap rows; drawn
as shapes the logo is sharp at any size and the same everywhere. Shades (░ ▒ ▓), which kitty
draws as dot patterns, are see-through fills of their cell (25, 50 and 75%), smooth at any
size; the middle dot (·) is a small square where the font puts it, the black square (■) a square
as wide as the cell, centered in it, as JetBrains Mono draws both. Used by the wallpaper
(hyprdori-logo-wallpaper), the boot splash (plymouth/install.sh) and the boot menu
(limine/install.sh), like fastfetch in kitty and the System Information window.

  hyprdori-logo-render --color '#cba6f7' --cell-height 24 --out logo.png
  hyprdori-logo-render --color '#cba6f7' --height 480 --out logo.png    the whole logo 480px high

Options:
  --color HEX          the logo's color (#rrggbb)
  --cell-height PX     height of a character cell (its width is 45.5% of it), or
  --height PX          the whole logo's height, rounded to whole cells
  --out FILE           the PNG to write: the whole grid, every line as wide as the longest,
                       its spaces and blank lines included
  --logo FILE          another text logo, e.g. dori-text (default: ~/.config/theme/logo/dori-logo)

Other characters are skipped, as spaces.
Needs ImageMagick (magick).
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
import tempfile
from pathlib import Path

DEFAULT_LOGO = Path.home() / ".config/theme/logo/dori-logo"

# Block characters by the quarters they fill: upper left, upper right, lower left, lower right
QUADRANTS = {
    0x2580: (1, 1, 0, 0), 0x2584: (0, 0, 1, 1), 0x2588: (1, 1, 1, 1), 0x258C: (1, 0, 1, 0), 0x2590: (0, 1, 0, 1),
    0x2596: (0, 0, 1, 0), 0x2597: (0, 0, 0, 1), 0x2598: (1, 0, 0, 0), 0x2599: (1, 0, 1, 1), 0x259A: (1, 0, 0, 1),
    0x259B: (1, 1, 1, 0), 0x259C: (1, 1, 0, 1), 0x259D: (0, 1, 0, 0), 0x259E: (0, 1, 1, 0), 0x259F: (0, 1, 1, 1),
}
# Nerd Font's triangles (Powerline extra), by the cell corners they join, x and y 0 or 1:
# ◣ lower left, ◢ lower right, ◤ upper left, ◥ upper right
TRIANGLES = {
    0xE0B8: ((0, 0), (0, 1), (1, 1)), 0xE0BA: ((1, 0), (1, 1), (0, 1)),
    0xE0BC: ((0, 0), (1, 0), (0, 1)), 0xE0BE: ((0, 0), (1, 0), (1, 1)),
}
# Shades by how much of the cell they cover, drawn as see-through fills: ░ ▒ ▓
SHADES = {0x2591: 0.25, 0x2592: 0.5, 0x2593: 0.75}
# The middle dot (·): its size for the cell's width, its center's height in the cell, as
# JetBrains Mono has it
MIDDLE_DOT, MIDDLE_DOT_SIZE, MIDDLE_DOT_Y = 0x00B7, 0.273, 0.514
# The black square (■): the cell's full width, as tall as wide, its center halfway down the cell
BLACK_SQUARE, BLACK_SQUARE_Y = 0x25A0, 0.5
# Braille bit order: dots 1-3 down the left, 4-6 down the right, then 7 and 8 at the bottom
BRAILLE = [(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (0, 3), (1, 3)]
# A cell's width for its height, as kitty draws JetBrains Mono: 600 by 1320 font units
CELL_RATIO = 600 / 1320


def shapes(lines: list[str], w: float, h: int) -> list[str]:
    """ImageMagick draw commands for every filled shape, cell by cell. Cells start and end at
    whole pixels, so neighbouring blocks meet without a seam whatever the width. Shades set
    their opacity, and the next shape sets it back."""
    out = []
    dot = max(1, round(min(w / 2, h / 4) * 0.55))
    middle = max(1, round(w * MIDDLE_DOT_SIZE))
    opacity = 1.0

    def fill(alpha: float) -> None:
        nonlocal opacity
        if alpha != opacity:
            out.append(f"fill-opacity {alpha}")
            opacity = alpha

    for row, line in enumerate(lines):
        for col, ch in enumerate(line):
            code = ord(ch)
            xs = (round(col * w), round((col + 0.5) * w), round((col + 1) * w))
            ys = (row * h, row * h + h // 2, (row + 1) * h)
            if code in SHADES:
                fill(SHADES[code])
                out.append(f"rectangle {xs[0]},{ys[0]} {xs[2] - 1},{ys[2] - 1}")
                continue
            fill(1.0)
            if code == BLACK_SQUARE:
                side = xs[2] - xs[0]
                y = round(row * h + h * BLACK_SQUARE_Y - side / 2)
                out.append(f"rectangle {xs[0]},{y} {xs[2] - 1},{y + side - 1}")
            elif code == MIDDLE_DOT:
                x = round(col * w + (w - middle) / 2)
                y = round(row * h + h * MIDDLE_DOT_Y - middle / 2)
                out.append(f"rectangle {x},{y} {x + middle - 1},{y + middle - 1}")
            elif 0x2801 <= code <= 0x28FF:
                bits = code - 0x2800
                for b, (cx, cy) in enumerate(BRAILLE):
                    if bits & (1 << b):
                        x = round(col * w + (cx + 0.5) * w / 2 - dot / 2)
                        y = round(row * h + (cy + 0.5) * h / 4 - dot / 2)
                        out.append(f"rectangle {x},{y} {x + dot - 1},{y + dot - 1}")
            elif code in QUADRANTS:
                for k, filled in enumerate(QUADRANTS[code]):
                    if filled:
                        i, j = k % 2, k // 2
                        # rectangles include both corners, hence the -1
                        out.append(f"rectangle {xs[i]},{ys[j]} {xs[i + 1] - 1},{ys[j + 1] - 1}")
            elif code in TRIANGLES:
                # pixel centers sit on whole numbers: the cell's edges are half a pixel out
                edge_x, edge_y = (xs[0] - 0.5, xs[2] - 0.5), (ys[0] - 0.5, ys[2] - 0.5)
                out.append("polygon " + " ".join(f"{edge_x[cx]},{edge_y[cy]}" for cx, cy in TRIANGLES[code]))
    return out


def render(logo: Path, color: str, cell_h: int, out: Path) -> None:
    lines = read_lines(logo)
    h = max(2, cell_h)
    w = h * CELL_RATIO
    drawn = shapes(lines, w, h)
    if not drawn:
        raise SystemExit(f"Nothing to draw in {logo}")
    width = round(max(len(line) for line in lines) * w)
    height = len(lines) * h
    with tempfile.TemporaryDirectory() as tmp:
        mvg = Path(tmp) / "logo.mvg"
        mvg.write_text(f"fill '{color}'\n" + "".join(f"{d}\n" for d in drawn))
        subprocess.run(
            ["magick", "-size", f"{width}x{height}", "xc:none", "+antialias", "-draw", f"@{mvg}", str(out)],
            check=True,
        )


def read_lines(logo: Path) -> list[str]:
    """The logo's lines, spaces and blank lines included: only the file's last line break goes."""
    text = logo.read_text(encoding="utf-8")
    return (text[:-1] if text.endswith("\n") else text).split("\n")


def rows(logo: Path) -> int:
    return len(read_lines(logo))


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--color")
    parser.add_argument("--cell-height", type=int)
    parser.add_argument("--height", type=int)
    parser.add_argument("--out")
    parser.add_argument("--logo", default=str(DEFAULT_LOGO))
    parser.add_argument("-h", "--help", action="store_true")
    args, rest = parser.parse_known_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0
    if rest or not args.color or not args.out or not (args.cell_height or args.height):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not re.match(r"^#[0-9a-fA-F]{6}$", args.color):
        print(f"--color takes #rrggbb, not '{args.color}'", file=sys.stderr)
        return 2
    logo = Path(args.logo).expanduser()
    if not logo.is_file():
        print(f"No logo at {logo}", file=sys.stderr)
        return 1
    cell_h = args.cell_height or max(2, round(args.height / rows(logo)))
    render(logo, args.color, cell_h, Path(args.out).expanduser())
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
