#!/usr/bin/env bash
# Checks Hyprdori before a commit: every script parses, and no old names are left.
# Prints what's wrong and exits 1, or says all is well. Takes a few seconds; nothing runs
# in the background.
#
#   hyprdori-check
set -uo pipefail

hyprdori=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)
cd "$hyprdori" || exit 1
failed=0
fail() { printf '\e[31m%s\e[0m\n' "$1"; failed=1; }

mapfile -t tracked < <(git ls-files --cached --others --exclude-standard)
# migrations and this check name the old paths on purpose
mapfile -t current < <(printf '%s\n' "${tracked[@]}" | grep -vE '^migrations/|^bin/\.local/bin/hyprdori-check$')

# Files parse: shell, Python, Lua, TOML and JSON, by their first line or extension
for file in "${tracked[@]}"; do
    [[ -f $file ]] || continue
    first=$(head -c 64 "$file" 2>/dev/null | tr -d '\0' | head -n1)
    case "$file:$first" in
        *.sh:* | *:'#!/usr/bin/env bash'* | *:'#!/bin/bash'* | *:'#!/bin/sh'*)
            bash -n "$file" 2>/dev/null || fail "shell syntax: $file" ;;
        *.py:* | *:'#!/usr/bin/env python3'*)
            python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$file" 2>/dev/null || fail "Python syntax: $file" ;;
        *.lua:*)
            luac -p "$file" 2>/dev/null || [[ $file == *.tpl ]] || fail "Lua syntax: $file" ;;
        *.toml:*)
            python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$file" 2>/dev/null || fail "TOML syntax: $file" ;;
        *.json:*)
            python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$file" 2>/dev/null || fail "JSON syntax: $file" ;;
    esac
done

# Every theme renders every template (in memory; nothing is written)
while IFS= read -r line; do
    fail "theme: $line"
done < <(python3 - "$hyprdori" <<'PY'
import importlib.machinery, importlib.util, sys
from pathlib import Path
root = Path(sys.argv[1])
loader = importlib.machinery.SourceFileLoader("theme_set", str(root / "bin/.local/bin/hyprdori-theme-set"))
spec = importlib.util.spec_from_loader("theme_set", loader)
ts = importlib.util.module_from_spec(spec)
loader.exec_module(ts)
ts.THEMES_DIR = root / "theme/.config/theme/themes"
ts.OVERRIDES_DIR = root / "theme/.config/theme/overrides"
templates = sorted((root / "theme/.config/theme/templates").glob("*.tpl"))
templates.append(root / "fastfetch/.config/fastfetch/base.jsonc")
names = sorted(p.parent.name for p in ts.THEMES_DIR.glob("*/colors.toml"))
if not names:
    print("no themes")
for name in names:
    try:
        theme = ts.load_theme(name)
    except Exception as e:
        print(f"{name}: {e}")
        continue
    for tpl in templates:
        try:
            out = ts.render(tpl.read_text(), theme, tpl.name)
        except Exception as e:
            print(f"{name}: {e}")
            continue
        left = ts.PLACEHOLDER_RE.search(out)
        if left:
            print(f"{name}: {tpl.name}: unfilled {left.group(0)}")
PY
)

# The shell names colors as the themes do
while IFS= read -r line; do
    fail "old color name: $line"
done < <(git grep -n -E 'Theme\.(highlight|accent2|accent3|text|subtext[01]|overlay[012]|surface[012]|base|mantle|crust|mauve|peach|teal|sky|sapphire|lavender|maroon|pink|rosewater|flamingo)\b' -- 'quickshell/*.qml' 2>/dev/null)

# Old names: the project is hyprdori (github.com/kuvk/... is the account and stays)
while IFS= read -r line; do
    fail "old name: $line"
done < <(git grep -n -I -i -E 'kuvk' -- "${current[@]}" 2>/dev/null | grep -v -E 'github\.com/kuvk/')
while IFS= read -r line; do
    fail "old path: $line"
done < <(git grep -n -I -E '(\.config/scripts/(theme-set|wallpaper|hypr-monitors|webapp|update|sysmaintenance|logo-wallpaper|convert-live-wallpapers)\.(py|sh))|share/dotfiles|config/dotfiles' -- "${current[@]}" 2>/dev/null)

if ((failed)); then
    exit 1
fi
echo "All well."
