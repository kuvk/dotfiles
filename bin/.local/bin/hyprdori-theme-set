#!/usr/bin/env python3
"""Switch the system-wide color theme.

Every theme is a colors.toml with the same named colors, and a neovim.lua, in
~/.config/theme/themes/<name>/ (hyprdori-theme-sync copies them). Templates in
~/.config/theme/templates/*.tpl are rendered into ~/.config/theme/current/, which every app
config points at, and running apps are told to reload. Colors a theme leaves out are worked
out. After Omarchy's omarchy-theme-color and omarchy-theme-set-templates
(https://github.com/basecamp/omarchy, MIT).

  hyprdori-theme-set <name>     apply a theme
  hyprdori-theme-set            re-apply the current theme (after editing templates)
  hyprdori-theme-set --list     list theme names
  hyprdori-theme-set --json     list themes with a few colors (used by quickshell)
  hyprdori-theme-set --current  print the current theme name
  hyprdori-theme-set --cursors  list the installed cursor themes as JSON
  hyprdori-theme-set --icon-themes  list the installed icon themes as JSON
  hyprdori-theme-set --icons NAME  apply an icon theme (Settings > Style saves the choice)
  hyprdori-theme-set --cursor NAME SIZE
                          apply a cursor everywhere (Settings > Style saves the choice)
  hyprdori-theme-set --fonts FONT DISPLAY on|off HINTING ANTIALIASING
                          apply the fonts (Settings > Fonts saves the choice): FONT for
                          terminals and fontconfig's monospace, DISPLAY for the shell, apps and
                          the login screen, or FONT there too with on (Monospace everywhere).
                          HINTING: none|slight|medium|full, ANTIALIASING: none|grayscale|rgba
  hyprdori-theme-set --login    rewrite the login screen's colors from Settings > Style > Lock screen
  hyprdori-theme-set --text-size  GTK's font size from Displays > Text size (hyprdori-monitors)
  hyprdori-theme-set --follow-wallpaper
                          the logo wallpaper in this theme's colors, while the desktop
                          shows the theme's background (picked in the wallpaper picker,
                          or Settings > Style > Background > Theme's)
  hyprdori-theme-set --window-buttons on|off
                          close button in GTK apps (Settings > Style saves the choice)
  hyprdori-theme-set --hypr      Hyprland's gaps, corners, window opacity and blur from Settings
                          into its generated theme.lua (the shell runs it on a change)
  hyprdori-theme-set --shape rounded|square
                          corners of the status lines in tmux, nvim and yazi, Neovim's
                          windows, LazyGit, btop and the starship prompt
                          (quickshell sets it: square in Work-Game or at radius 0)
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
THEME_DIR = HOME / ".config/theme"
THEMES_DIR = THEME_DIR / "themes"
# Hyprdori's changes to a theme's colors (overrides/<name>.toml), kept apart so syncing the
# themes doesn't touch them
OVERRIDES_DIR = THEME_DIR / "overrides"
TEMPLATES_DIR = THEME_DIR / "templates"
CURRENT_DIR = THEME_DIR / "current"
ICONS_DIR = THEME_DIR / "icons"
STATE_FILE = CURRENT_DIR / "theme"
DEFAULT_THEME = "catppuccin"

# Rendered files that also need a copy somewhere an app can find them
EXTRA_DESTINATIONS = {
    "hyprland.lua": HOME / ".config/hypr/configs/generated/theme.lua",
    # btop and bat find themes by name in their own themes folders
    "btop.theme": HOME / ".config/btop/themes/current.theme",
    "bat.tmTheme": HOME / ".config/bat/themes/Current.tmTheme",
    "cava": HOME / ".config/cava/themes/current",
    "yazi-theme.toml": HOME / ".config/yazi/theme.toml",
    # catppuccin/tmux may be at plugins/catppuccin/tmux and, through TPM, at
    # plugins/tmux. Every copy gets the flavor, since the last one loaded wins.
    "tmux.conf": [
        HOME / ".tmux/plugins/catppuccin/tmux/themes/catppuccin_current_tmux.conf",
        HOME / ".tmux/plugins/tmux/themes/catppuccin_current_tmux.conf",
    ],
    "cliamp.toml": HOME / ".config/cliamp/themes/system.toml",
    # eza's icons, the same as yazi's (theme/eza-icons.py writes the template)
    "eza-theme.yml": HOME / ".config/eza/theme.yml",
    # GTK adds these to whatever theme is set
    "gtk.css": HOME / ".config/gtk-3.0/gtk.css",
    "gtk4.css": HOME / ".config/gtk-4.0/gtk.css",
    "gtk-settings.ini": [HOME / ".config/gtk-3.0/settings.ini", HOME / ".config/gtk-4.0/settings.ini"],
    "kdeglobals": HOME / ".config/kdeglobals",
    "qt5ct.conf": HOME / ".config/qt5ct/qt5ct.conf",
    "qt6ct.conf": HOME / ".config/qt6ct/qt6ct.conf",
    "kvantum.kvconfig": HOME / ".config/Kvantum/kvantum.kvconfig",
    "kvantum-current.kvconfig": HOME / ".config/Kvantum/current/current.kvconfig",
    "kvantum-current.svg": HOME / ".config/Kvantum/current/current.svg",
    "hyprtoolkit.conf": HOME / ".config/hypr/hyprtoolkit.conf",
    "cursor-index.theme": HOME / ".icons/default/index.theme",
    "sddm-cursor.conf": Path("/var/lib/hyprdori/cursor.conf"),
    # the login screen; that folder only exists after sddm/install.sh
    "sddm-theme.conf": Path("/var/lib/hyprdori/theme.conf"),
}
# Written only when the app's folder exists (don't create a half plugin dir)
ONLY_IF_PRESENT = {"tmux.conf", "cliamp.toml"}

FASTFETCH_SOURCE = HOME / ".config/fastfetch/base.jsonc"
FASTFETCH_OUTPUT = HOME / ".config/fastfetch/config.jsonc"
STARSHIP_SOURCE = HOME / ".config/starship/base.toml"
STARSHIP_OUTPUT = HOME / ".config/starship.toml"

# The named colors in every theme's colors.toml (missing ones are worked out)
PALETTE = (
    "background dark_background darker_background lighter_background "
    "foreground dark_foreground light_foreground bright_foreground "
    "accent selection muted "
    "red yellow orange green cyan blue magenta brown "
    "bright_red bright_yellow bright_green bright_cyan bright_blue bright_magenta"
).split()
# Older names that themes and templates may still use
LEGACY_PALETTE = {"bg": "background", "dark_bg": "dark_background", "darker_bg": "darker_background",
                  "lighter_bg": "lighter_background", "fg": "foreground", "dark_fg": "dark_foreground",
                  "light_fg": "light_foreground", "bright_fg": "bright_foreground"}
ANSI = ("background red green yellow blue magenta cyan foreground "
        "muted bright_red bright_green bright_yellow bright_blue bright_magenta bright_cyan bright_foreground").split()
CURSOR_DIRS = (HOME / ".icons", HOME / ".local/share/icons", Path("/usr/share/icons"))

HINTINGS = ("none", "slight", "medium", "full")
ANTIALIASINGS = ("none", "grayscale", "rgba")

# --cursor sets these: Quickshell may not have saved the choice to its file yet
SETTINGS_OVERRIDE: dict = {}

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
# {{ name }}, {{ name.hex }}, {{ mix a b 30% }}: words on one line (Vim's {{{ folds aren't)
PLACEHOLDER_RE = re.compile(r"\{\{[ \t]*([A-Za-z_][\w.]*(?:[ \t]+[^{}\s]+)*)[ \t]*\}\}")


def notify(body: str) -> None:
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Theme", "-i", "preferences-desktop-theme", body], check=False)


def run_quiet(cmd: list[str]) -> None:
    if shutil.which(cmd[0]):
        subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def available_themes() -> list[str]:
    if not THEMES_DIR.is_dir():
        return []
    return sorted(p.parent.name for p in THEMES_DIR.glob("*/colors.toml"))


def current_theme() -> str:
    try:
        name = STATE_FILE.read_text().strip()
    except FileNotFoundError:
        return DEFAULT_THEME
    return name or DEFAULT_THEME


def luminance(color: str) -> float:
    channels = [int(color[i : i + 2], 16) / 255 for i in (1, 3, 5)]
    r, g, b = [c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4 for c in channels]
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a: str, b: str) -> float:
    high, low = sorted((luminance(a), luminance(b)), reverse=True)
    return (high + 0.05) / (low + 0.05)


def current_shape() -> str:
    try:
        return (CURRENT_DIR / "shape").read_text().strip()
    except FileNotFoundError:
        return "rounded"


ICONS_FILE = THEME_DIR / "icons.toml"


def icon_strings(colors: dict) -> dict:
    """icons.toml as yazi [icon] lines and a Lua table for Neovim, in this theme's colors:
    folders accent, links cyan, files and extensions in their own color (a theme color
    name or #hex)."""
    try:
        icons = tomllib.loads(ICONS_FILE.read_text())
    except (OSError, tomllib.TOMLDecodeError) as e:
        print(f"theme-set: {ICONS_FILE}: {e}", file=sys.stderr)
        icons = {}
    color = lambda c: colors.get(c, c if HEX_RE.match(c or "") else colors["foreground"])
    toml = lambda v: json.dumps(v, ensure_ascii=False)
    dirs = [(n, d["icon"]) for d in icons.get("dir", []) for n in d.get("names", [])]
    files = [(n, f["icon"], color(f.get("color", "text"))) for f in icons.get("file", []) for n in f.get("names", [])]
    exts = [(n, e["icon"], color(e.get("color", "text"))) for e in icons.get("ext", []) for n in e.get("names", [])]
    link = icons.get("link", {})
    lua = lambda v: json.dumps(v, ensure_ascii=False)  # a JSON string is a Lua string literal
    lua_entries = lambda rows: "{ " + ", ".join(f"[{lua(n)}] = {{ {lua(i)}, {lua(c)} }}" for n, i, c in rows) + " }"
    return {
        "yazi_icon_dirs": "\n".join(f'\t{{ name = {toml(n)}, text = {toml(i)}, fg = {toml(colors["accent"])} }},' for n, i in dirs),
        "yazi_icon_files": "\n".join(f'\t{{ name = {toml(n)}, text = {toml(i)}, fg = {toml(c)} }},' for n, i, c in files),
        "yazi_icon_exts": "\n".join(f'\t{{ name = {toml(n)}, text = {toml(i)}, fg = {toml(c)} }},' for n, i, c in exts),
        "icon_link_dir": toml(link.get("dir", "\ue5ff"))[1:-1],
        "icon_link_file": toml(link.get("file", "\uf15b"))[1:-1],
        "icon_link_broken": toml(link.get("broken", "\U000f086f"))[1:-1],
        "nvim_icons": "{ dirs = { " + ", ".join(f"[{lua(n)}] = {lua(i)}" for n, i in dirs) + " }, files = "
        + lua_entries(files) + ", exts = " + lua_entries(exts)
        + f", link_dir = {lua(link.get('dir', chr(0xe5ff)))}, link_file = {lua(link.get('file', chr(0xf15b)))}"
        + f", link_broken = {lua(link.get('broken', chr(0xf086f)))} }}",
    }


def shell_settings() -> dict:
    """What's chosen in Quickshell's Settings: the saved settings, then the shell's
    defaults.json (a fresh install, before the shell has saved any), then these."""
    settings = {
        "font": "JetBrainsMono Nerd Font",
        "displayFont": "SF Pro Display",
        "monoEverywhere": True,
        "fontHinting": "slight",
        "fontAntialiasing": "rgba",
        "windowButtons": False,
        "wallpaperFollowsTheme": True,
        "lockAvatar": True,
        "lockRounded": True,
        "lockPowerOpacity": 85,
        "accentOverrides": {},
        "lockInputOpacity": 75,
        "cursorTheme": "Adwaita",
        "cursorSize": 24,
        # Hyprland's look in normal mode (hyprland.lua.tpl)
        "radius": 10,
        "gapsIn": 5,
        "gapsOut": 10,
        "activeOpacity": 0.95,
        "inactiveOpacity": 0.88,
        "blur": True,
        "iconTheme": "Papirus",
    }
    sources = [HOME / ".config/quickshell/config/defaults.json"]
    sources += sorted((HOME / ".local/state/quickshell/by-shell").glob("*/settings.json"))
    for path in sources:
        try:
            saved = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        settings.update({key: saved[key] for key in settings if key in saved})
        # settings saved before these names: the Nerd Font was the terminals' font, and
        # "Nerd Fonts only" put it everywhere
        if "font" not in saved and saved.get("nerdFont"):
            settings["font"] = saved["nerdFont"]
        if "monoEverywhere" not in saved and "nerdFontOnly" in saved:
            settings["monoEverywhere"] = bool(saved["nerdFontOnly"])
    return settings | SETTINGS_OVERRIDE


def cursor_themes() -> list[str]:
    names = {
        path.parent.parent.name
        for folder in CURSOR_DIRS
        for path in folder.glob("*/cursors/left_ptr")
        if path.parent.parent.name != "default"
    }
    return sorted(names, key=str.lower)


def icon_themes() -> list[str]:
    names = set()
    for folder in CURSOR_DIRS:
        for index in folder.glob("*/index.theme"):
            if index.parent.name in ("default", "hicolor"):
                continue
            text = index.read_text(errors="ignore")
            # cursor themes have an index.theme too, without icon folders
            if re.search(r"^Directories\s*=\s*\S", text, re.M) and not re.search(r"^Hidden\s*=\s*true", text, re.M | re.I):
                names.add(index.parent.name)
    return sorted(names, key=str.lower)


def icon_theme_for(name: str, mode: str) -> str:
    """A theme with a variant for the mode uses it, so Papirus follows light and dark;
    choosing the variant itself (Papirus-Dark) keeps it in both."""
    variant = f"{name}-{mode.capitalize()}"
    return variant if variant in icon_themes() else name


def mix(a: str, b: str, amount: float) -> str:
    """a blended toward b by amount (0..1), as #rrggbb."""
    ca = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    cb = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{int(x * (1 - amount) + y * amount + 0.5):02x}" for x, y in zip(ca, cb))


def palette(data: dict) -> tuple[dict, dict]:
    """A theme's colors with what it leaves out worked out: hex colors,
    and the other values (border gradients like "rgba(..) rgba(..) 45deg") apart."""
    raw = {k: str(v) for k, v in data.items() if isinstance(v, str)}
    c = {k: v.lower() for k, v in raw.items() if HEX_RE.match(v)}
    specs = {k: v for k, v in raw.items() if not HEX_RE.match(v) and k not in ("mode", "theme_type")}
    for short, long in LEGACY_PALETTE.items():
        c.setdefault(long, c.get(short, ""))
    for i, name in enumerate(("red", "green", "yellow", "blue", "magenta", "cyan")):
        c.setdefault(name, c.get(f"color{i + 1}", ""))
    for i, name in enumerate(("bright_red", "bright_green", "bright_yellow", "bright_blue", "bright_magenta", "bright_cyan")):
        c.setdefault(name, c.get(f"color{i + 9}", ""))
    c = {k: v for k, v in c.items() if v}
    c.setdefault("background", c.get("color0", "#1e1e2e"))
    c.setdefault("foreground", c.get("color7", "#cdd6f4"))
    c.setdefault("light_foreground", c.get("color7", c["foreground"]))
    c.setdefault("bright_foreground", c.get("color15", c["foreground"]))
    c.setdefault("lighter_background", c.get("color0", c["background"]))
    c.setdefault("dark_foreground", c.get("color8", c["foreground"]))
    c.setdefault("muted", c.get("color8", c["dark_foreground"]))
    c.setdefault("selection", c.get("selection_background", c.get("color8", c["background"])))
    c.setdefault("selection_background", c["selection"])
    c.setdefault("selection_foreground", c["bright_foreground"])
    for hue in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        c.setdefault(hue, c["foreground"])
    c.setdefault("orange", c["yellow"])
    c.setdefault("brown", mix(c["orange"], "#000000", 0.5))
    c.setdefault("dark_background", mix(c["background"], "#000000", 0.25))
    c.setdefault("darker_background", mix(c["background"], "#000000", 0.5))
    for hue in ("red", "yellow", "green", "cyan", "blue", "magenta"):
        c.setdefault(f"bright_{hue}", mix(c[hue], "#ffffff", 0.2))
    c.setdefault("accent", c["blue"])
    c["cursor"] = c["bright_foreground"]
    for i, name in enumerate(ANSI):
        c[f"color{i}"] = c[name]
    return c, specs


def shell_slots(c: dict) -> dict:
    """Colors by the names older settings saved (base, mauve, ...), for an accent chosen
    then; dim text steps evenly from dark_foreground to foreground."""
    fg, dim = c["foreground"], c["dark_foreground"]
    return {
        "base": c["background"], "mantle": c["dark_background"], "crust": c["darker_background"],
        "surface0": c["lighter_background"], "surface1": c["selection"], "surface2": c["muted"],
        "overlay0": dim, "overlay1": mix(dim, fg, 0.2), "overlay2": mix(dim, fg, 0.4),
        "subtext0": mix(dim, fg, 0.6), "subtext1": mix(dim, fg, 0.8), "text": fg,
        "red": c["red"], "maroon": c["bright_red"], "peach": c["orange"], "yellow": c["yellow"],
        "green": c["green"], "teal": c["cyan"], "sky": c["bright_cyan"], "sapphire": mix(c["blue"], c["cyan"], 0.5),
        "blue": c["blue"], "lavender": c["bright_blue"], "mauve": c["magenta"], "pink": c["bright_magenta"],
        "flamingo": mix(c["red"], fg, 0.5), "rosewater": mix(c["bright_red"], c["bright_foreground"], 0.6),
        "accent": c["accent"], "accent2": c["accent"], "accent3": c["orange"],
        "selection_bg": c["selection_background"], "selection_fg": c["selection_foreground"],
    }


def theme_mode(data: dict, colors: dict) -> str:
    mode = data.get("mode") or data.get("theme_type")
    if mode in ("dark", "light"):
        return mode
    bg = colors["background"]
    return "light" if sum(int(bg[i:i + 2], 16) for i in (1, 3, 5)) > 382 else "dark"


def accent_override(name: str, colors: dict) -> str | None:
    """Settings > Style > Accent: one of this theme's colors (or a #hex) instead of
    its own accent; none is the theme's."""
    chosen = shell_settings().get("accentOverrides", {})
    value = chosen.get(name) if isinstance(chosen, dict) else None
    if isinstance(value, dict):  # saved by the shell's older Settings: {accent: name}
        value = value.get("accent")
    if isinstance(value, str):
        if HEX_RE.match(value):
            return value.lower()
        return colors.get(value) or shell_slots(colors).get(value)
    return None


def nvim_colorscheme(folder: Path, mode: str) -> str:
    """The colorscheme the theme's neovim.lua names (a LazyVim spec); aether, drawn from the
    palette, for a theme without one."""
    try:
        match = re.search(r'colorscheme\s*=\s*"([^"]+)"', (folder / "neovim.lua").read_text())
    except OSError:
        match = None
    return match.group(1) if match else "aether"


def load_theme(name: str) -> dict:
    path = THEMES_DIR / name / "colors.toml"
    with path.open("rb") as f:
        data = tomllib.load(f)
    override = OVERRIDES_DIR / f"{name}.toml"
    if override.is_file():
        with override.open("rb") as f:
            data |= tomllib.load(f)
    colors, specs = palette(data)
    colors["accent"] = accent_override(name, colors) or colors["accent"]
    mode = theme_mode(data, colors)

    shell = shell_settings()
    hinting, antialiasing = shell["fontHinting"], shell["fontAntialiasing"]
    strings = {
        "theme": name,
        "theme_name": data.get("name") or name.replace("-", " ").title(),
        "mode": mode,
        "theme_type": mode,
        "nvim_colorscheme": nvim_colorscheme(path.parent, mode),
        "cursor_theme": shell["cursorTheme"],
        "cursor_size": str(shell["cursorSize"]),
        # Settings > Fonts: the terminals' font (also monospace), and what apps show text in
        "nerd_font": shell["font"],
        "text_font": shell["font"] if shell["monoEverywhere"] else shell["displayFont"],
        "font_hinting": hinting,
        "font_antialiasing": antialiasing,
        "gtk_font_pt": gtk_font_pt(),
        # the cursor line in Neovim's neo-tree (Catppuccin's: surface0 64% over base); yazi's
        # hover highlight uses it too
        "cursorline": mix(colors["background"], colors["lighter_background"], 0.64),
        # yazi's hover highlight ends: rounded caps, or full blocks. yazi draws these in the
        # highlight's color (a space would come out in the background's), so either way the
        # bar starts one character before the icon.
        "yazi_pad_open": "\u2588" if current_shape() == "square" else "\ue0b6",
        "yazi_pad_close": "\u2588" if current_shape() == "square" else "\ue0b4",
        "fc_antialias": "false" if antialiasing == "none" else "true",
        "fc_hinting": "false" if hinting == "none" else "true",
        "fc_hintstyle": f"hint{hinting}",
        "fc_rgba": "rgb" if antialiasing == "rgba" else "none",
        "fc_lcdfilter": "lcddefault" if antialiasing == "rgba" else "lcdnone",
        "xft_antialias": "0" if antialiasing == "none" else "1",
        "xft_hinting": "0" if hinting == "none" else "1",
        "decoration_layout": ":close" if shell["windowButtons"] else ":",
        "border_style": "single" if current_shape() == "square" else "rounded",
        "hypr_gaps_in": str(int(shell["gapsIn"])),
        "hypr_gaps_out": str(int(shell["gapsOut"])),
        "hypr_rounding": str(int(shell["radius"])),
        "hypr_active_opacity": f"{float(shell['activeOpacity']):g}",
        "hypr_inactive_opacity": f"{float(shell['inactiveOpacity']):g}",
        "hypr_blur": "true" if shell["blur"] else "false",
        # the login screen, as the lock screen: the theme's colors
        "login_avatar": colors["accent"],
        "login_inputOutline": colors["accent"],
        # the password field's and buttons' fill: the background with 5% of the text color, as
        # Omarchy's field (lock, login and boot screens)
        "login_input": mix(colors["background"], colors["foreground"], 0.05),
        "login_dots": colors["foreground"],
        "login_text": colors["foreground"],
        "login_check": mix(colors["foreground"], colors["background"], 0.5),
        "login_fail": colors["red"],
        "login_caps": colors["yellow"],
        "login_show_avatar": "true" if shell["lockAvatar"] else "false",
        "login_power_bg": mix(colors["background"], colors["foreground"], 0.05),
        "login_power_opacity": str(shell["lockPowerOpacity"] / 100),
        # outlined like the password field, in the accent; lighter under the cursor
        "login_power_outline": colors["accent"],
        "login_power_hover_outline": mix(colors["accent"], colors["foreground"], 0.4),
        "login_input_opacity": str(shell["lockInputOpacity"] / 100),
        # Settings > Style > Lock screen > Rounded corners: the password field's (lock, login and boot
        # screens) and the login screen's buttons; the windows' corner radius, or 8 with it at 0
        "login_radius": str((int(shell["radius"]) or 8) if shell["lockRounded"] else 0),
        "icon_theme": icon_theme_for(shell["iconTheme"], mode),
        "prefer_dark": "0" if mode == "light" else "1",
        # adw-gtk3, when installed, follows gtk.css in plain GTK3 and GTK4 apps too;
        # Adwaita only does in libadwaita apps
        "gtk_theme": ("adw-gtk3" if Path("/usr/share/themes/adw-gtk3").is_dir() else "Adwaita")
        + ("" if mode == "light" else "-dark"),
    }
    strings.update(icon_strings(colors))  # icons.toml: folder, file and link icons

    return {"colors": colors, "specs": specs, "strings": strings, "dir": path.parent}


def gradient(spec: str, colors: dict) -> tuple[list[str], str]:
    """A border spec ("rgba(..) rgba(..) 45deg", or a color name) as its colors and angle."""
    parts, angle = [], ""
    for part in spec.split():
        if re.fullmatch(r"-?\d+(\.\d+)?deg", part):
            angle = part[:-3]
        else:
            parts.append(colors.get(part, part))
    return parts, angle


def theme_ref(ref: str, fallback: str, theme: dict) -> str:
    """A theme value by name (a border gradient or a color), else the fallback (a name or
    a literal value)."""
    values = theme["specs"] | theme["colors"]
    return values.get(ref) or values.get(fallback) or fallback or ref


def render(text: str, theme: dict, source: str) -> str:
    colors, strings = theme["colors"], theme["strings"]

    def color_format(value: str, fmt: str, key: str) -> str:
        if fmt == "":
            return value
        if fmt in ("hex", "strip"):
            return value[1:]
        if fmt == "rgb":
            return ", ".join(str(int(value[i : i + 2], 16)) for i in (1, 3, 5))
        if fmt == "ansi":  # 24-bit SGR foreground code, e.g. for fastfetch
            return "38;2;" + ";".join(str(int(value[i : i + 2], 16)) for i in (1, 3, 5))
        if fmt == "ansi_bg":  # the same as a background
            return "48;2;" + ";".join(str(int(value[i : i + 2], 16)) for i in (1, 3, 5))
        raise KeyError(f"{source}: unknown placeholder {{{{ {key} }}}}")

    def substitute(match: re.Match) -> str:
        expr = match.group(1).strip()
        words = expr.split()
        # {{ mix a b 30% }}, mix_strip (no #), mix_rgb ("r,g,b"), and mix.rgb, mix.hex, mix.ansi
        # like the colors' own formats
        if words[0].startswith("mix.") and len(words) == 4:
            mixed = substitute(re.match(r"(.*)", "mix " + " ".join(words[1:])))
            return color_format(mixed, words[0][4:], expr)
        if words[0] in ("mix", "mix_strip", "mix_rgb") and len(words) == 4:
            start, end = (colors.get(w, w if HEX_RE.match(w) else None) for w in words[1:3])
            if not start or not end:
                raise KeyError(f"{source}: unknown color in {{{{ {expr} }}}}")
            amount = float(words[3].rstrip("%"))
            mixed = mix(start, end, amount / 100 if words[3].endswith("%") or amount > 1 else amount)
            if words[0] == "mix_strip":
                return mixed[1:]
            if words[0] == "mix_rgb":
                return ",".join(str(int(mixed[i : i + 2], 16)) for i in (1, 3, 5))
            return mixed
        # {{ hypr_gradient key fallback }}: a Hyprland Lua color or gradient
        if words[0] in ("hypr_gradient", "shell_gradient", "gradient_start") and len(words) in (2, 3):
            parts, angle = gradient(theme_ref(words[1], words[2] if len(words) == 3 else "", theme), colors)
            if words[0] == "gradient_start":
                first = parts[0] if parts else ""
                found = re.fullmatch(r"(?i)rgba?\(([0-9a-f]{6})[0-9a-f]{0,2}\)", first)
                return "#" + found.group(1).lower() if found else first
            if words[0] == "shell_gradient":
                return " ".join(parts) + (f" {angle}deg" if angle else "")
            if len(parts) == 1:
                return json.dumps(parts[0])
            body = "{ colors = { " + ", ".join(json.dumps(c) for c in parts) + " }"
            return body + (f", angle = {angle} }}" if angle else " }")
        if len(words) == 1:
            name, _, fmt = expr.partition(".")
            if fmt == "" and name.endswith("_strip") and name[:-6] in colors:
                return colors[name[:-6]][1:]
            if name in colors:
                return color_format(colors[name], fmt, expr)
            if name in strings and fmt == "":
                return strings[name]
            if name in theme["specs"] and fmt == "":
                return theme["specs"][name]
        raise KeyError(f"{source}: unknown placeholder {{{{ {expr} }}}}")

    return PLACEHOLDER_RE.sub(substitute, text)


def write_if_changed(path: Path, content: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        if path.read_text() == content:
            return False
    except FileNotFoundError:
        pass
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(content)
    tmp.replace(path)  # atomic, so file watchers never see a half-written file
    return True


def render_fastfetch(theme: dict) -> None:
    """fastfetch has no includes either: config.jsonc is base.jsonc with the
    theme's colors filled in (read on every run)."""
    if not FASTFETCH_SOURCE.exists():
        return
    header = "// Generated by hyprdori-theme-set from ~/.config/fastfetch/base.jsonc; edit that file\n"
    try:
        content = render(FASTFETCH_SOURCE.read_text(), theme, "fastfetch/base.jsonc")
    except KeyError as e:  # a typo in base.jsonc must not stop the theme switch
        print(f"theme-set: {e}", file=sys.stderr)
        return
    write_if_changed(FASTFETCH_OUTPUT, header + content)


def render_starship(theme: dict) -> None:
    """starship has no includes: ~/.config/starship.toml is generated from
    ~/.config/starship/base.toml plus the palette (starship rereads it every prompt)."""
    if not STARSHIP_SOURCE.exists():
        return
    base = re.sub(r"^palette\s*=.*$", "palette = 'theme'", STARSHIP_SOURCE.read_text(), count=1, flags=re.M)
    # base.toml's own palette is the fallback; the theme's replaces it
    base = re.sub(r"\n# [^\n]*\n\[palettes\.theme\][\s\S]*$", "\n", base)
    # square corners in Work-Game or with the corner radius at 0 (--shape)
    if current_shape() == "square":
        base = base.replace("╭", "┌").replace("╰", "└")
    palette = "\n[palettes.theme]\n" + "".join(
        f'{name} = "{value}"\n' for name, value in theme["colors"].items() if not name.startswith("color")
    )
    header = "# Generated by hyprdori-theme-set from ~/.config/starship/base.toml; edit that file\n"
    write_if_changed(STARSHIP_OUTPUT, header + base.rstrip() + "\n" + palette)


def icons_dir(name: str) -> str:
    """Power menu icons from theme-icons.py, or Catppuccin's for a theme
    that has none yet."""
    for candidate in (name, "catppuccin"):
        if (ICONS_DIR / candidate / "lock.svg").is_file():
            return str(ICONS_DIR / candidate)
    return ""


def theme_background(theme: dict) -> Path | None:
    """This theme's own background: the logo in magenta on the dark background (hyprdori-logo-wallpaper), drawn
    once per theme and colors into ~/.local/share/hyprdori/backgrounds/default. The wallpaper
    and the lock screen show it while they follow the theme (Settings)."""
    colors, name = theme["colors"], theme["strings"]["theme"]
    folder = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "hyprdori/backgrounds/default"
    path = folder / f"dori-theme-{name}-{colors['magenta'][1:]}-on-{colors['dark_background'][1:]}.png"
    if path.exists():
        return path
    folder.mkdir(parents=True, exist_ok=True)
    for old in folder.glob(f"dori-theme-{name}-*.png"):  # this theme in older colors
        old.unlink(missing_ok=True)
    run_quiet([str(HOME / ".local/bin/hyprdori-logo-wallpaper"), "--bg", colors["dark_background"], "--fg", colors["magenta"],
               "--size", "30", "--output", str(path)])
    return path if path.exists() else None


def render_quickshell(theme: dict) -> None:
    background = theme_background(theme)
    theme["background"] = background
    data = {
        "theme": theme["strings"]["theme"],
        "name": theme["strings"]["theme_name"],
        "mode": theme["strings"]["mode"],
        "icons": icons_dir(theme["strings"]["theme"]),
        "colors": theme["colors"],
        # the lock screen shows it unless another image is chosen (Settings > Style > Lock screen)
        "background": str(background) if background else "",
    }
    write_if_changed(CURRENT_DIR / "quickshell.json", json.dumps(data, indent=2) + "\n")


def render_ls_colors() -> None:
    """dircolors' output for .zshrc, so shells set LS_COLORS without running it."""
    # dircolors outputs nothing unless TERM matches, and the shell's picker and autostart have none
    env = os.environ | {"TERM": "xterm-256color"}
    out = subprocess.run(["dircolors", "-b", str(CURRENT_DIR / "dir_colors")], capture_output=True, text=True, env=env)
    if out.returncode == 0:
        write_if_changed(CURRENT_DIR / "ls_colors.zsh", out.stdout)
    else:
        print(f"theme-set: dircolors: {out.stderr.strip()}", file=sys.stderr)


def generate(name: str) -> dict:
    theme = load_theme(name)
    theme["changed"] = set()
    for tpl in sorted(TEMPLATES_DIR.glob("*.tpl")):
        out_name = tpl.name.removesuffix(".tpl")
        content = render(tpl.read_text(), theme, tpl.name)
        write_if_changed(CURRENT_DIR / out_name, content)
        targets = EXTRA_DESTINATIONS.get(out_name, [])
        for dest in targets if isinstance(targets, list) else [targets]:
            if out_name in ONLY_IF_PRESENT and not dest.parent.parent.is_dir():
                continue
            if out_name.startswith("sddm-") and not dest.parent.is_dir():
                continue
            if out_name == "tmux.conf" and not (dest.parent.parent / "catppuccin.tmux").is_file():
                continue  # some other plugin named "tmux"
            try:
                if write_if_changed(dest, content):
                    theme["changed"].add(out_name)
            except OSError as e:
                print(f"theme-set: could not write {dest}: {e}", file=sys.stderr)

    render_quickshell(theme)
    render_starship(theme)
    render_fastfetch(theme)

    # A theme may ship its own file for any app (e.g. a hand-tuned btop.theme);
    # it replaces the rendered one.
    for override in theme["dir"].iterdir():
        if override.name != "colors.toml" and override.is_file():
            write_if_changed(CURRENT_DIR / override.name, override.read_text())

    render_ls_colors()
    write_if_changed(STATE_FILE, name + "\n")
    return theme


def hypr_running() -> bool:
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and shutil.which("hyprctl") is not None


def apply_cursor(strings: dict) -> None:
    interface = "org.gnome.desktop.interface"
    run_quiet(["gsettings", "set", interface, "cursor-theme", strings["cursor_theme"]])
    run_quiet(["gsettings", "set", interface, "cursor-size", strings["cursor_size"]])
    if hypr_running():
        run_quiet(["hyprctl", "setcursor", strings["cursor_theme"], strings["cursor_size"]])
    set_xwayland_cursor(strings["cursor_theme"], strings["cursor_size"])


def set_xwayland_cursor(theme: str, size: str) -> None:
    """XWayland's default arrow, for X11 apps that set no cursor of their own (Parsec).
    Hyprland sets it once, when XWayland starts, so it doesn't follow `hyprctl setcursor`."""
    if not os.environ.get("DISPLAY") or not shutil.which("xsetroot"):
        return
    env = {**os.environ, "XCURSOR_THEME": theme, "XCURSOR_SIZE": size}
    subprocess.run(["xsetroot", "-cursor_name", "left_ptr"], env=env, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def gtk_font_pt() -> str:
    """GTK's and Qt's font size in points for Displays > Text size (px, kept by
    hyprdori-monitors): the shell's text size, as kitty's (0.75 pt a px, so 12 px is 9 pt, 14 px
    10.5). Set as the font size rather than GTK's text-scaling-factor, which Electron apps on
    Wayland (Obsidian, Mullvad) apply to their content without resizing the window, leaving
    an empty strip."""
    try:
        size = int(json.loads((HOME / ".config/hypr/monitors.json").read_text()).get("text_size", 12))
    except (OSError, ValueError, TypeError, AttributeError):
        size = 12
    return f"{max(6.0, round(size * 0.75 * 2) / 2):g}"


def apply_fonts(strings: dict) -> None:
    interface = "org.gnome.desktop.interface"
    pt = strings["gtk_font_pt"]
    run_quiet(["gsettings", "set", interface, "font-name", f"{strings['text_font']} {pt}"])
    run_quiet(["gsettings", "set", interface, "document-font-name", f"{strings['text_font']} {pt}"])
    run_quiet(["gsettings", "set", interface, "monospace-font-name", f"{strings['nerd_font']} {pt}"])
    run_quiet(["gsettings", "set", interface, "text-scaling-factor", "1.0"])
    run_quiet(["gsettings", "set", interface, "font-hinting", strings["font_hinting"]])
    run_quiet(["gsettings", "set", interface, "font-antialiasing", strings["font_antialiasing"]])
    run_quiet(["gsettings", "set", interface, "font-rgba-order", "rgb"])


def apply_window_buttons(strings: dict) -> None:
    run_quiet(["gsettings", "set", "org.gnome.desktop.wm.preferences", "button-layout", strings["decoration_layout"]])


def set_gtk_theme(strings: dict) -> None:
    """Wayland GTK apps read these; settings.ini (rendered above) is for XWayland ones."""
    interface = "org.gnome.desktop.interface"
    run_quiet(["gsettings", "set", interface, "gtk-theme", strings["gtk_theme"]])
    run_quiet(["gsettings", "set", interface, "icon-theme", strings["icon_theme"]])
    apply_cursor(strings)
    apply_fonts(strings)
    apply_window_buttons(strings)
    run_quiet(["gsettings", "set", interface, "color-scheme", f"prefer-{strings['mode']}"])


def reload_apps(theme: dict) -> None:
    colors, strings = theme["colors"], theme["strings"]

    # quickshell and neovim watch their generated files; poke quickshell anyway
    # in case the watch was lost when the file was replaced
    run_quiet(["qs", "ipc", "call", "theme", "reload"])

    if hypr_running():
        # The borders from the generated theme.lua (hyprland.lua.tpl), in every mode
        run_quiet([
            "hyprctl", "eval",
            "package.loaded['configs.generated.theme'] = nil; local ok, t = pcall(require, 'configs.generated.theme'); "
            "if ok then hl.config({ general = { col = { active_border = t.active_border, inactive_border = t.inactive_border } } }) end",
        ])

    run_quiet(["pkill", "-USR1", "-x", "kitty"])
    run_quiet(["pkill", "-USR2", "-x", "btop"])
    run_quiet(["pkill", "-USR2", "-x", "cava"])  # reload colors
    run_quiet(["pkill", "-USR1", "-x", "swayimg"])  # re-reads current/swayimg.lua
    # bat reads themes from a cache that must be rebuilt
    if "bat.tmTheme" in theme.get("changed", ()) and shutil.which("bat"):
        run_quiet(["bat", "cache", "--build"])
    if "yazi-theme.toml" in theme.get("changed", ()):
        restart_yazi()
    redraw_prompts()
    if shutil.which("tmux") and subprocess.run(["tmux", "info"], capture_output=True).returncode == 0:
        run_quiet(["tmux", "source-file", str(HOME / ".tmux.conf")])
    # a running cliamp re-reads the theme file when told to switch to it
    if "cliamp.toml" in theme.get("changed", ()) and shutil.which("cliamp") and (HOME / ".config/cliamp/cliamp.sock").exists():
        run_quiet(["cliamp", "theme", "system"])

    # file dialogs: the portal reads gtk.css only when it starts
    if "gtk.css" in theme.get("changed", ()):
        run_quiet(["systemctl", "--user", "try-restart", "xdg-desktop-portal-gtk.service"])

    browsers(colors["background"])

    set_gtk_theme(strings)

    wallpaper = strings.get("wallpaper")
    if wallpaper and hypr_running():
        path = Path(os.path.expanduser(wallpaper))
        if not path.is_absolute():
            path = theme["dir"] / path
        if path.exists():
            out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True)
            try:
                monitors = [m["name"] for m in json.loads(out.stdout)]
            except (json.JSONDecodeError, KeyError, TypeError):
                monitors = []
            for monitor in monitors:
                run_quiet(["hyprctl", "hyprpaper", "wallpaper", f"{monitor},{path},cover"])


def redraw_prompts() -> None:
    """Open zsh shells redraw their starship prompt in the new colors. Only
    shells that registered themselves (.zshrc, they trap USR1) are signalled:
    USR1 would end any other process."""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "zsh-prompt"
    if not runtime.is_dir():
        return
    for entry in runtime.iterdir():
        try:
            pid = int(entry.name)
            with open(f"/proc/{pid}/comm") as f:
                if f.read().strip() != "zsh":
                    raise ProcessLookupError
            os.kill(pid, signal.SIGUSR1)
        except (ValueError, OSError):
            entry.unlink(missing_ok=True)  # gone, or the pid was reused


def restart_yazi() -> None:
    """yazi can't reload its theme: every yazi started by yazi-live.sh is told
    to quit (it writes its folder) and the script reopens it right there."""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "yazi-live"
    if not shutil.which("ya") or not runtime.is_dir():
        return
    for client in runtime.glob("*.client"):
        pid = client.stem
        try:
            os.kill(int(pid), 0)
        except (ValueError, ProcessLookupError):
            client.unlink(missing_ok=True)  # left over from a crash
            continue
        except PermissionError:
            continue
        (runtime / f"{pid}.restart").touch()
        run_quiet(["ya", "emit-to", pid, "quit"])


BROWSER_HELPER = "/usr/local/bin/browser-theme-policy"


def browsers(color: str) -> None:
    """Chromium/Brave theme color via managed policy (browser-theme-setup.sh).
    Does nothing until that one-time setup has been run."""
    if not Path(BROWSER_HELPER).exists() or not shutil.which("sudo"):
        return
    result = subprocess.run(["sudo", "-n", BROWSER_HELPER, color[1:]],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if result.returncode != 0:
        return
    # Running browsers pick the policy up without a restart
    for proc, binary in (("chromium", "chromium"), ("brave", "brave")):
        if shutil.which(binary) and subprocess.run(["pgrep", "-x", proc], capture_output=True).returncode == 0:
            subprocess.Popen([binary, "--refresh-platform-policy", "--no-startup-window"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def themes_json() -> str:
    current = current_theme()
    result = []
    for name in available_themes():
        try:
            theme = load_theme(name)
        except (ValueError, tomllib.TOMLDecodeError) as e:
            print(e, file=sys.stderr)
            continue
        c = theme["colors"]
        result.append({
            "theme": name,
            "name": theme["strings"]["theme_name"],
            "mode": theme["strings"]["mode"],
            "current": name == current,
            # for the theme carousel's palette preview cards
            "colors": {k: c[k] for k in (
                "background", "dark_background", "darker_background", "lighter_background", "selection",
                "dark_foreground", "foreground", "accent", "red", "orange", "yellow", "green", "cyan", "blue",
                "magenta", "bright_magenta",
            )},
        })
    return json.dumps(result)


def write_hypr_look() -> None:
    """Only Hyprland's generated theme.lua again, with the gaps, corners, opacity and blur
    from Settings, so Hyprland starts with them (the shell applies them live)."""
    theme = load_theme(current_theme())
    content = render((TEMPLATES_DIR / "hyprland.lua.tpl").read_text(), theme, "hyprland.lua.tpl")
    write_if_changed(CURRENT_DIR / "hyprland.lua", content)
    write_if_changed(EXTRA_DESTINATIONS["hyprland.lua"], content)


def set_shape(shape: str) -> None:
    if not write_if_changed(CURRENT_DIR / "shape", shape + "\n"):
        return
    # templates that draw corners (lazygit)
    generate(current_theme())
    # nvim watches the file
    if subprocess.run(["tmux", "info"], capture_output=True).returncode == 0:
        run_quiet(["tmux", "source-file", str(HOME / ".tmux.conf")])
    restart_yazi()
    btop_corners(shape)


def btop_corners(shape: str) -> None:
    """btop has no includes and rewrites btop.conf itself, so the one line is changed in
    place; a running btop re-reads it on SIGUSR2."""
    conf = HOME / ".config/btop/btop.conf"
    try:
        text = conf.read_text()
    except OSError:
        return
    line = f"rounded_corners = {'false' if shape == 'square' else 'true'}"
    new = re.sub(r"^rounded_corners\s*=.*$", line, text, count=1, flags=re.M)
    if new != text:
        conf.write_text(new)
        run_quiet(["pkill", "-USR2", "-x", "btop"])


def follow_wallpaper(theme: dict) -> None:
    """The theme's background (theme_background) on every monitor while the wallpaper
    follows the theme: picking the theme's own background turns that on (the wallpaper
    picker, Settings > Style > Background > Theme's), picking another turns it off. The lock screen follows the
    theme on its own (Settings > Style > Lock screen)."""
    if not shell_settings().get("wallpaperFollowsTheme"):
        return
    path = theme.get("background") or theme_background(theme)
    if not path:
        return
    current = HOME / ".local/state/wallpaper/current"
    if current.resolve() != path.resolve():
        run_quiet([str(HOME / ".local/bin/hyprdori-wallpaper"), "set", "static", str(path)])


def notify_switch(summary: str) -> None:
    """The theme notification. When the boot menu and splash still have other colors
    (theme-boot.sh --check), it says so, and its Update button runs theme-boot.sh in a
    kitty window (password prompt and output)."""
    script = HOME / ".config/scripts/theme-boot.sh"
    stale = script.exists() and subprocess.run(
        [str(script), "--check"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not stale or not shutil.which("notify-send"):
        notify(summary)
        return
    ask = ('a=$(notify-send -a Theme -i preferences-desktop-theme -c x-hyprdori.hint -A update=Update "$1" "$2"); '
           '[ "$a" = update ] && exec "$0" --window')
    body = "Click Update for the bootloader and Plymouth to follow the new theme."
    subprocess.Popen(["bash", "-c", ask, str(script), summary, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv == ["--hypr"]:
        write_hypr_look()
        return 0
    if len(argv) == 2 and argv[0] == "--shape" and argv[1] in ("rounded", "square"):
        set_shape(argv[1])
        return 0
    if argv and argv[0] == "--list":
        print("\n".join(available_themes()))
        return 0
    if argv and argv[0] == "--json":
        print(themes_json())
        return 0
    if argv and argv[0] == "--cursors":
        print(json.dumps(cursor_themes()))
        return 0
    if len(argv) == 3 and argv[0] == "--cursor":
        if argv[1] not in cursor_themes() or not argv[2].isdigit():
            print(f"Unknown cursor '{argv[1]} {argv[2]}'", file=sys.stderr)
            return 1
        SETTINGS_OVERRIDE.update(cursorTheme=argv[1], cursorSize=int(argv[2]))
        apply_cursor(generate(current_theme())["strings"])
        return 0
    if argv and argv[0] == "--icon-themes":
        print(json.dumps(icon_themes()))
        return 0
    if len(argv) == 2 and argv[0] == "--icons":
        if argv[1] not in icon_themes():
            print(f"Unknown icon theme '{argv[1]}'", file=sys.stderr)
            return 1
        SETTINGS_OVERRIDE.update(iconTheme=argv[1])
        strings = generate(current_theme())["strings"]
        run_quiet(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", strings["icon_theme"]])
        return 0
    if len(argv) == 6 and argv[0] == "--fonts":
        font, display, everywhere, hinting, antialiasing = argv[1:]
        if everywhere not in ("on", "off") or hinting not in HINTINGS or antialiasing not in ANTIALIASINGS:
            print(f"Unknown font options '{everywhere} {hinting} {antialiasing}'", file=sys.stderr)
            return 1
        SETTINGS_OVERRIDE.update(font=font, displayFont=display, monoEverywhere=everywhere == "on",
                                 fontHinting=hinting, fontAntialiasing=antialiasing)
        apply_fonts(generate(current_theme())["strings"])
        # kitty rereads kitty-font.conf
        run_quiet(["pkill", "-USR1", "-x", "kitty"])
        return 0
    if argv == ["--text-size"]:
        # Displays > Text size changed (hyprdori-monitors): GTK's font size
        apply_fonts(generate(current_theme())["strings"])
        return 0
    if argv == ["--follow-wallpaper"]:
        follow_wallpaper(load_theme(current_theme()))
        return 0
    if argv == ["--login"]:
        generate(current_theme())
        return 0
    if len(argv) == 2 and argv[0] == "--window-buttons" and argv[1] in ("on", "off"):
        SETTINGS_OVERRIDE.update(windowButtons=argv[1] == "on")
        apply_window_buttons(generate(current_theme())["strings"])
        return 0
    if argv and argv[0] == "--current":
        print(current_theme())
        return 0

    name = argv[0] if argv else current_theme()
    if name not in available_themes():
        print(f"Unknown theme '{name}'. Available: {', '.join(available_themes())}", file=sys.stderr)
        return 1

    colors_file = CURRENT_DIR / "colors.sh"
    before = colors_file.read_text() if colors_file.exists() else ""
    try:
        theme = generate(name)
    except (ValueError, KeyError, tomllib.TOMLDecodeError) as e:
        print(f"theme-set: {e}", file=sys.stderr)
        notify(f"Failed to apply {name}: {e}")
        return 1

    reload_apps(theme)
    follow_wallpaper(theme)
    # A switch, or new colors (an accent from Settings): the boot screens follow only when
    # their installers run, which the notification offers
    if argv:
        notify_switch(f"Switched to {theme['strings']['theme_name']}")
    elif colors_file.read_text() != before:
        notify_switch("Theme colors changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
