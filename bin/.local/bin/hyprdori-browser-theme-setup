#!/usr/bin/env bash
# One-time setup so hyprdori-theme-set can color Chromium and Brave (Settings >
# Appearance > Theme must be "Classic"). The color
# goes into the browsers' managed policy (BrowserThemeColor). Those folders
# belong to root, so this installs a small root-owned helper that only accepts
# a 6-digit hex color, and a sudoers rule that lets the user run exactly that
# without a password. Nothing else gets root. Run it without sudo: it asks for the password
# (sudo), and the rule is for the user who ran it.
#
#   hyprdori-browser-theme-setup            install
#   hyprdori-browser-theme-setup --unlock   drop the color policy for now, e.g. to switch
#                                           Appearance > Theme to Classic; the next theme
#                                           switch (or hyprdori-theme-set) puts it back
#   hyprdori-browser-theme-setup --remove   undo everything
#   hyprdori-browser-theme-setup --keep-display-font
#                                           the browsers' own text (tabs, address bar, menus)
#                                           in the display font while Monospace everywhere puts
#                                           the terminals' font everywhere else; no sudo
#   hyprdori-browser-theme-setup --follow-font
#                                           back to the font everything else uses; no sudo
#
# The font choice is ~/.config/hyprdori/browser-display-font (there or not), which
# hyprdori-theme-set turns into a fontconfig rule for Chromium, Brave, Firefox and Zen; restart
# the browsers to see it.

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
set -euo pipefail

# The browsers' font: a per-user setting, so no root (through sudo, it's done as the user)
case ${1:-} in
    --keep-display-font | --follow-font)
        if ((EUID == 0)); then
            [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]] || { echo "Run it as yourself." >&2; exit 1; }
            exec sudo -u "$SUDO_USER" "$(readlink -f "$0")" "$@"
        fi
        flag=${XDG_CONFIG_HOME:-$HOME/.config}/hyprdori/browser-display-font
        if [[ $1 == --keep-display-font ]]; then
            mkdir -p "${flag%/*}"
            : >"$flag"
            echo "Browsers keep the display font for their own text while Monospace everywhere is on."
        else
            rm -f "$flag"
            echo "Browsers use the same font as everything else."
        fi
        "$HOME/.local/bin/hyprdori-theme-set" --login >/dev/null 2>&1 || true
        echo "Restart the browsers to see it."
        exit 0
        ;;
esac

HELPER=/usr/local/bin/browser-theme-policy
SUDOERS=/etc/sudoers.d/browser-theme-policy
POLICY_DIRS=(/etc/chromium/policies/managed /etc/brave/policies/managed)

# Run without root: again through sudo, by its full path (sudo's PATH has no ~/.local/bin)
if ((EUID != 0)); then
    exec sudo "$(readlink -f "$0")" "$@"
fi

user="${SUDO_USER:-}"
if [[ -z $user || $user == root ]]; then
    echo "Run through sudo from your own account, so the rule is for your user." >&2
    exit 1
fi

if [[ ${1:-} == --unlock ]]; then
    for dir in "${POLICY_DIRS[@]}"; do rm -f "$dir/color.json"; done
    cat <<'MSG'
Theme policy removed. Now:
  1. Restart the browser (close every window).
  2. Settings > Appearance > Theme: choose "Classic" (not GTK or QT).
  3. Close the browser, then run ~/.local/bin/hyprdori-theme-set to color it again.
MSG
    exit 0
fi

if [[ ${1:-} == --remove ]]; then
    rm -f "$HELPER" "$SUDOERS"
    for dir in "${POLICY_DIRS[@]}"; do rm -f "$dir/color.json"; done
    echo "Removed. Restart the browsers to drop the theme color."
    exit 0
fi

install -d -m 0755 "${POLICY_DIRS[@]}"

cat >"$HELPER" <<'HELPER_EOF'
#!/bin/bash
# Writes the browser theme color policy. Only accepts six lowercase hex digits.
set -euo pipefail
export PATH=/usr/bin:/bin
color="${1:-}"
[[ $color =~ ^[0-9a-f]{6}$ ]] || { echo "usage: browser-theme-policy rrggbb" >&2; exit 1; }
for dir in /etc/chromium/policies/managed /etc/brave/policies/managed; do
    [[ -d $dir && ! -L $dir ]] || continue
    tmp=$(mktemp)
    printf '{"BrowserThemeColor": "#%s", "BrowserColorScheme": "device"}\n' "$color" >"$tmp"
    install -m 0644 -o root -g root -T "$tmp" "$dir/color.json"
    rm -f "$tmp"
done
HELPER_EOF
chown root:root "$HELPER"
chmod 0755 "$HELPER"

rule="$user ALL=(root) NOPASSWD: $HELPER [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]"
tmp=$(mktemp)
printf '# Lets hyprdori-theme-set write the browser theme color (hyprdori-browser-theme-setup)\n%s\n' "$rule" >"$tmp"
if visudo -cf "$tmp" >/dev/null; then
    install -m 0440 -o root -g root -T "$tmp" "$SUDOERS"
    rm -f "$tmp"
else
    rm -f "$tmp"
    echo "visudo rejected the rule; nothing installed." >&2
    exit 1
fi

echo "Done. Switch theme once (or run ~/.local/bin/hyprdori-theme-set) to apply the color."
