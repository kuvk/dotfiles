#!/bin/bash
# The next keyboard layout on every keyboard (Hyprland's xkb layouts, input.lua). Called by the
# bar's layout button (services/Hypr.qml); Alt+Space does the same in Hyprland itself.
#
#   hyprdori-switch-layout

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
for kb in $(hyprctl devices | awk '/Keyboard at/ {getline; print $1}'); do
    hyprctl switchxkblayout "$kb" next 2>/dev/null
done
