#!/usr/bin/env bash
# The boot splash (Plymouth) and boot menu (Limine) in the current theme: runs both
# installers with one password prompt, and copies the login screen's theme (sddm/hyprdori)
# where SDDM reads it. They read the theme and logo when they run, so a theme or accent
# change shows at boot only after this; the login screen's colors follow on their own.
#
#   hyprdori-theme-boot            update, unless they're already built from the current theme
#   hyprdori-theme-boot --force    update anyway
#   hyprdori-theme-boot --check    say whether an update is needed (exit 0 yes, 1 no); no root
#   hyprdori-theme-boot --window   in a window (hyprdori-present): the text logo, what this
#                                  does, Yes / No, the output, then any key closes it (the
#                                  notification's Update button, Settings, the update window)
#   --radius PX                    with any of these: the boot splash's password field with
#                                  these corners (0 square) instead of Settings > Style's
#
# Asks for the password in a terminal (sudo) or, started from the desktop, in the polkit
# dialog (pkexec). Plymouth rebuilds every initramfs, which takes a while.
#
# What they were last built from is kept as a checksum in /var/lib/hyprdori/boot-theme:
# the theme's colors, the logo and the installers themselves.

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
set -euo pipefail

self=$(readlink -f "$0")
scripts=$(dirname "$self")
hyprdori=$(cd "$scripts/../../.." && pwd)
stamp=/var/lib/hyprdori/boot-theme

note() { printf '%s\n' "$1"; command -v notify-send >/dev/null && [[ ! -t 1 ]] && notify-send -a "Boot screens" "$1" 2>/dev/null; true; }

# Checksum of everything the two installers draw from (run as the user whose theme it is)
fingerprint() {
    local home=$1
    cat "$home/.config/theme/current/colors.sh" "$home"/.config/theme/logo/dori-{logo,text} \
        "$hyprdori"/plymouth/* "$hyprdori/limine/install.sh" "$scripts/hyprdori-logo-render" \
        "$hyprdori"/sddm/hyprdori/* 2>/dev/null |
        sha256sum | cut -d' ' -f1
}

# --- Root part: started by the user part below through sudo or pkexec ------------------------
if [[ ${1:-} == --as-root ]]; then
    user=${2:?user}
    home=$(getent passwd "$user" | cut -d: -f6)
    export SUDO_USER=$user
    shift 2
    "$hyprdori/plymouth/install.sh" "$@"
    # Limine with the options it was installed with (hyprdori-update does the same)
    options=()
    if [[ -r /efi/EFI/limine/limine.conf ]]; then
        read -ra options <<<"$(sed -n 's/^# Options: //p' /efi/EFI/limine/limine.conf)"
    fi
    "$hyprdori/limine/install.sh" "${options[@]}"
    # the login screen's layout, once sddm/install.sh has set it up; its colors are in
    # /var/lib/hyprdori/theme.conf, which the theme writes itself
    if [[ -d /usr/share/sddm/themes/hyprdori ]]; then
        install -m 0644 "$hyprdori"/sddm/hyprdori/*.qml "$hyprdori"/sddm/hyprdori/metadata.desktop \
            "$hyprdori"/sddm/hyprdori/theme.conf /usr/share/sddm/themes/hyprdori/
    fi
    if [[ -d ${stamp%/*} ]]; then
        fingerprint "$home" >"$stamp"
        chown "$user" "$stamp"
    fi
    exit 0
fi

# --- Options: --radius goes to the boot splash; the rest says what to do ---------------------------
action=update
splash=()
while (($#)); do
    case $1 in
        --force) action=force ;;
        --check) action=check ;;
        --window) action=window ;;
        --in-window) action=in-window ;;
        --radius)
            [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "hyprdori-theme-boot: --radius takes pixels, e.g. 0 or 8" >&2; exit 2; }
            splash=(--radius "$2")
            shift
            ;;
        *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 2 ;;
    esac
    shift
done

# --- In a window: the text logo, what this does, Yes / No, then the output ------------------------
present="$scripts/hyprdori-present"
if [[ $action == window ]]; then
    exec "$present" window hyprdori-window "Boot screens" "$self" --in-window "${splash[@]}"
fi
if [[ $action == in-window ]]; then
    "$present" header
    "$present" box "The boot menu (Limine) and the boot splash (Plymouth) keep the look they were" \
        "installed with. This installs both again with the current theme, logos and password" \
        "field, and the login screen's layout, so they match the desktop from the next start." \
        "" "It needs your password (sudo) and takes about a minute: the splash is rebuilt into" \
        "every initramfs."
    status=0
    if "$present" confirm "Update the boot screens now?"; then
        "$present" step "Boot screens"
        "$self" --force "${splash[@]}" || status=$?
    else
        echo "  Left as they are."
    fi
    "$present" done "$status"
    exit "$status"
fi

# --- User part -----------------------------------------------------------------------------------
((EUID != 0)) || { echo "Run this as yourself; it asks for the password itself." >&2; exit 1; }
current=$(fingerprint "$HOME")
installed=$(cat "$stamp" 2>/dev/null || true)

if [[ $action == check ]]; then
    [[ $current != "$installed" ]]
    exit
fi

if [[ $action != force && $current == "$installed" ]]; then
    note "The boot screens already match the theme."
    exit 0
fi

if [[ -t 0 ]]; then
    sudo "$self" --as-root "$USER" "${splash[@]}"
else
    pkexec "$self" --as-root "$USER" "${splash[@]}"
fi && note "Boot screens updated, from the next boot." \
    || { note "Boot screens not updated."; exit 1; }
