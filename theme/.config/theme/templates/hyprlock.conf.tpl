# {{ theme_name }} — generated by theme-set, do not edit.
# lockscreen.sh fills in the @PLACEHOLDERS@: monitor, background and the colors from Settings.

# Colors for lockscreen.sh: @RAIN=rgba({{ crust.hex }}66) @SOLID=rgb({{ crust.hex }})

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = out, 0.25, 1, 0.5, 1
    animation = fadeIn, 1, 4, out
    animation = fadeOut, 1, 3, out
}

background {
    monitor =
    path = @PICTURE@
    # rain style: transparent, the unimatrix windows show through (misc:session_lock_xray)
    color = @COLOR@
}

# Clock and date, top right
label {
    monitor = @MONITOR@
    text = $TIME
    color = rgb(@CLOCK@)
    font_size = 120
    font_family = SF Pro Display
    position = -30, -10
    halign = right
    valign = top
    shadow_passes = 3
}

label {
    monitor = @MONITOR@
    text = cmd[update:60000] date +"%A, %-d %B %Y"
    color = rgb(@CLOCK@)
    font_size = 33
    font_family = SF Pro Display
    position = -30, -170
    halign = right
    valign = top
    shadow_passes = 3
}

# Card behind the avatar and password
shape {
    monitor = @MONITOR@
    size = 340, 290
    color = rgba({{ base.hex }}bf)
    rounding = 9
    border_size = 1
    border_color = rgba(@OUTLINE@4d)
    position = 0, 0
    halign = center
    valign = center
}

image {
    monitor = @MONITOR@
    path = $HOME/.face
    size = 135
    border_size = 2
    border_color = rgb(@OUTLINE@)
    position = 0, 45
    halign = center
    valign = center
}

input-field {
    monitor = @MONITOR@
    size = 260, 36
    rounding = -1
    outline_thickness = 1
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgb(@OUTLINE@)
    inner_color = rgba({{ subtext1.hex }}33)
    font_color = rgb(@DOTS@)
    check_color = rgb(@DOTS@)
    fail_color = rgb({{ red.hex }})
    capslock_color = rgb({{ yellow.hex }})
    fade_on_empty = false
    placeholder_text = <span foreground="##@TEXT@"><i>󰌾  Logged in as </i></span><b><span foreground="##@DOTS@">$USER</span></b>
    fail_text = <i>ACCESS DENIED</i>
    position = 0, -85
    halign = center
    valign = center
}
