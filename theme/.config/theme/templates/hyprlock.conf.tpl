# {{ theme_name }} — generated by theme-set, do not edit.
# lockscreen.sh fills in the @PLACEHOLDERS@: monitor, background and the colors from Settings.

# Colors for lockscreen.sh: @RAIN=rgba({{ crust.hex }}66) @SOLID=rgb({{ crust.hex }})

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = out, 0.25, 1, 0.5, 1
    animation = fadeIn, 1, 4, out
    animation = fadeOut, 1, 3, out
}

background {
    monitor =
    path = @PICTURE@
    # rain style: transparent, the unimatrix windows show through (misc:session_lock_xray)
    color = @COLOR@
}

# Clock and date, top right
label {
    monitor = @MONITOR@
    text = $TIME
    color = rgb(@CLOCK@)
    font_size = 72
    font_family = {{ text_font }}
    position = -30, -10
    halign = right
    valign = top
    # shadow_passes = 3
}

label {
    monitor = @MONITOR@
    text = cmd[update:60000] date +"%a %-d %b"
    color = rgb(@DATE@)
    font_size = 28
    font_family = {{ text_font }}
    position = -30, -120
    halign = right
    valign = top
    # shadow_passes = 3
}

# Card behind the avatar and password
shape {
    monitor = @MONITOR@
    size = 380, 300
    color = rgba(@BOX_BG@)
    rounding = 6
    border_size = 2
    border_color = rgb(@BOX_OUTLINE@)
    position = 0, 0
    halign = center
    valign = center
}

image {
    monitor = @MONITOR@
    path = $HOME/.face
    size = 135
    border_size = 2
    border_color = rgb(@AVATAR@)
    position = 0, 45
    halign = center
    valign = center
}

input-field {
    monitor = @MONITOR@
    size = 260, 36
    rounding = -1
    outline_thickness = 1
    dots_size = 0.3
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgb(@INPUT_OUTLINE@)
    inner_color = rgba(@INPUT_BG@)
    font_color = rgb(@DOTS@)
    check_color = rgb(@CHECK@)
    fail_color = rgb(@FAIL@)
    capslock_color = rgb(@CAPS@)
    fade_on_empty = false
    placeholder_text = <span foreground="##@TEXT@"><i>󰌾  Logged in as </i></span><b><span foreground="##@USER@">$USER</span></b>
    fail_text = <i>ACCESS DENIED</i>
    position = 0, -85
    halign = center
    valign = center
    font_family = {{ text_font }}
}
