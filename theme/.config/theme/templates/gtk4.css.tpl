/* {{ theme_name }} — generated by theme-set, do not edit.
   libadwaita takes its accent from these variables; GTK3 can't parse them, so they're here
   and the colors both share are in current/gtk.css. */
@import url("../theme/current/gtk.css");

:root {
  --accent-bg-color: {{ accent2 }};
  --accent-fg-color: {{ base }};
  --accent-color: {{ accent2 }};
}
