/* {{ theme_name }}, generated by hyprdori-theme-set.
   libadwaita takes its accent from these variables; GTK3 can't parse them, so they're here
   and the colors both share are in current/gtk.css. */
@import url("../theme/current/gtk.css");

:root {
  --accent-bg-color: {{ accent }};
  --accent-fg-color: {{ background }};
  --accent-color: {{ accent }};
}

/* GTK4 dims disabled widgets with a filter; gtk.css sets their colors instead */
button.suggested-action:disabled,
button.suggested-action:disabled > label {
  filter: none;
}
