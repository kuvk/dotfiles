<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Generated by hyprdori-theme-set from Settings > Fonts: hinting, antialiasing and the font -->
<fontconfig>
  <match target="font">
    <edit mode="assign" name="antialias"><bool>{{ fc_antialias }}</bool></edit>
    <edit mode="assign" name="hinting"><bool>{{ fc_hinting }}</bool></edit>
    <edit mode="assign" name="hintstyle"><const>{{ fc_hintstyle }}</const></edit>
    <edit mode="assign" name="rgba"><const>{{ fc_rgba }}</const></edit>
    <edit mode="assign" name="lcdfilter"><const>{{ fc_lcdfilter }}</const></edit>
  </match>
  <!-- The font: first for "monospace", which terminals and code editors ask for -->
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend_first" binding="strong"><string>{{ nerd_font }}</string></edit>
  </match>
</fontconfig>
