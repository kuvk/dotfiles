<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Generated by hyprdori-theme-set from Settings > Fonts: hinting, antialiasing and the font -->
<fontconfig>
  <match target="font">
    <edit mode="assign" name="antialias"><bool>{{ fc_antialias }}</bool></edit>
    <edit mode="assign" name="hinting"><bool>{{ fc_hinting }}</bool></edit>
    <edit mode="assign" name="hintstyle"><const>{{ fc_hintstyle }}</const></edit>
    <edit mode="assign" name="rgba"><const>{{ fc_rgba }}</const></edit>
    <edit mode="assign" name="lcdfilter"><const>{{ fc_lcdfilter }}</const></edit>
  </match>
  <!-- The font: first for "monospace", which terminals and code editors ask for; not in
       browsers, where pages keep the browser's own fonts -->
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <test name="prgname" compare="not_eq"><string>chromium</string></test>
    <test name="prgname" compare="not_eq"><string>brave</string></test>
    <test name="prgname" compare="not_eq"><string>firefox</string></test>
    <test name="prgname" compare="not_eq"><string>zen</string></test>
    <edit name="family" mode="prepend_first" binding="strong"><string>{{ nerd_font }}</string></edit>
  </match>
  <!-- The browsers' own text (tabs, address bar, menus: GTK's font): the display font with
       Monospace everywhere when they don't follow the font (hyprdori-browser-theme-setup, follow-font false);
       otherwise browser_font is text_font and these change nothing -->
  <match target="pattern">
    <test name="prgname"><string>chromium</string></test>
    <test name="family"><string>{{ text_font }}</string></test>
    <edit name="family" mode="assign" binding="strong"><string>{{ browser_font }}</string></edit>
  </match>
  <match target="pattern">
    <test name="prgname"><string>brave</string></test>
    <test name="family"><string>{{ text_font }}</string></test>
    <edit name="family" mode="assign" binding="strong"><string>{{ browser_font }}</string></edit>
  </match>
  <match target="pattern">
    <test name="prgname"><string>firefox</string></test>
    <test name="family"><string>{{ text_font }}</string></test>
    <edit name="family" mode="assign" binding="strong"><string>{{ browser_font }}</string></edit>
  </match>
  <match target="pattern">
    <test name="prgname"><string>zen</string></test>
    <test name="family"><string>{{ text_font }}</string></test>
    <edit name="family" mode="assign" binding="strong"><string>{{ browser_font }}</string></edit>
  </match>
</fontconfig>
