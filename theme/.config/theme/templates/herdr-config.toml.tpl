# {{ theme_name }} — generated by theme-set, do not edit.
# Source: ~/.config/theme/templates/herdr-config.toml.tpl
onboarding = false

[keys]
prefix = "ctrl+s"

# Ctrl+H/J/K/L: vim-herdr-navigation plugin, like vim-tmux-navigator in tmux
[[keys.command]]
key = "ctrl+h"
type = "plugin_action"
command = "vim-herdr-navigation.left"
description = "navigate left"

[[keys.command]]
key = "ctrl+j"
type = "plugin_action"
command = "vim-herdr-navigation.down"
description = "navigate down"

[[keys.command]]
key = "ctrl+k"
type = "plugin_action"
command = "vim-herdr-navigation.up"
description = "navigate up"

[[keys.command]]
key = "ctrl+l"
type = "plugin_action"
command = "vim-herdr-navigation.right"
description = "navigate right"

[terminal]
default_shell = "/bin/zsh"

[ui.sound.agents]
claude = "on"

[theme.custom]
accent = "{{ accent }}"
panel_bg = "{{ base }}"
sidebar_bg = "{{ mantle }}"
active_row_bg = "{{ surface0 }}"
selection_bg = "{{ selection_bg }}"
surface0 = "{{ surface0 }}"
surface1 = "{{ surface1 }}"
surface_dim = "{{ mantle }}"
overlay0 = "{{ overlay0 }}"
overlay1 = "{{ overlay1 }}"
text = "{{ text }}"
subtext0 = "{{ subtext0 }}"
mauve = "{{ mauve }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
red = "{{ red }}"
blue = "{{ blue }}"
teal = "{{ teal }}"
peach = "{{ peach }}"
