-- {{ theme_name }}, generated by hyprdori-theme-set
return {
  name = "{{ theme }}",
  colorscheme = "{{ nvim_colorscheme }}",
  background = "{{ mode }}",
  accent2 = "{{ accent }}",
  accent3 = "{{ accent }}",
  -- the cursor line in every window and neo-tree, and yazi's hover highlight
  cursorline = "{{ cursorline }}",
  -- icons.toml: folders by name, files and extensions, links (neo-tree, nvim-web-devicons)
  icons = {{ nvim_icons }},
  yank = { bg = "{{ accent }}", fg = "{{ selection }}" },
  selection = { bg = "{{ selection_background }}", fg = "{{ selection_foreground }}" },
  -- Palette for the aether colorscheme, used by themes without their own
  aether = {
    bg = "{{ background }}",
    dark_bg = "{{ dark_background }}",
    darker_bg = "{{ darker_background }}",
    lighter_bg = "{{ lighter_background }}",
    fg = "{{ foreground }}",
    dark_fg = "{{ mix dark_foreground foreground 20% }}",
    light_fg = "{{ mix dark_foreground foreground 60% }}",
    bright_fg = "{{ color15 }}",
    muted = "{{ muted }}",
    red = "{{ red }}",
    yellow = "{{ yellow }}",
    orange = "{{ orange }}",
    green = "{{ green }}",
    cyan = "{{ cyan }}",
    blue = "{{ blue }}",
    magenta = "{{ magenta }}",
    brown = "{{ bright_red }}",
    bright_red = "{{ bright_red }}",
    bright_yellow = "{{ color11 }}",
    bright_green = "{{ color10 }}",
    bright_cyan = "{{ bright_cyan }}",
    bright_blue = "{{ bright_blue }}",
    bright_magenta = "{{ bright_magenta }}",
    accent = "{{ accent }}",
    cursor = "{{ cursor }}",
    foreground = "{{ foreground }}",
    background = "{{ background }}",
    selection = "{{ selection }}",
    selection_foreground = "{{ selection_foreground }}",
    selection_background = "{{ selection_background }}",
  },
}
