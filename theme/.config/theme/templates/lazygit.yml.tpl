# {{ theme_name }}, generated by hyprdori-theme-set
# Loaded after ~/.config/lazygit/config.yml through LG_CONFIG_FILE
gui:
  # Square in Work-Game or with the corner radius at 0 (hyprdori-theme-set --shape)
  border: '{{ border_style }}'
  theme:
    activeBorderColor:
      - '{{ accent }}'
      - bold
    inactiveBorderColor:
      - '{{ muted }}'
    optionsTextColor:
      - '{{ green }}'
    selectedLineBgColor:
      - '{{ lighter_background }}'
    cherryPickedCommitBgColor:
      - '{{ selection }}'
    cherryPickedCommitFgColor:
      - '{{ accent }}'
    unstagedChangesColor:
      - '{{ red }}'
    defaultFgColor:
      - '{{ foreground }}'
    searchingActiveBorderColor:
      - '{{ yellow }}'
  authorColors:
    '*': '{{ magenta }}'
