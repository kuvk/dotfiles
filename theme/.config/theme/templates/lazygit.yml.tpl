# {{ theme_name }} — generated by theme-set, do not edit
# Loaded after ~/.config/lazygit/config.yml through LG_CONFIG_FILE
gui:
  theme:
    activeBorderColor:
      - '{{ accent }}'
      - bold
    inactiveBorderColor:
      - '{{ accent2 }}'
    optionsTextColor:
      - '{{ green }}'
    selectedLineBgColor:
      - '{{ surface0 }}'
    cherryPickedCommitBgColor:
      - '{{ surface1 }}'
    cherryPickedCommitFgColor:
      - '{{ accent }}'
    unstagedChangesColor:
      - '{{ red }}'
    defaultFgColor:
      - '{{ text }}'
    searchingActiveBorderColor:
      - '{{ yellow }}'
  authorColors:
    '*': '{{ mauve }}'
