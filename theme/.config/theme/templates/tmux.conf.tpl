# {{ theme_name }}, generated by hyprdori-theme-set
# A catppuccin/tmux flavor ("current"). hyprdori-theme-set copies it into the
# plugin's themes folder and re-sources ~/.tmux.conf, so the plugin rebuilds
# its status styles (which it bakes in with set -F) from these colors.
# Plain `set -g` (the stock flavors use -o, "only if unset"): the plugin only
# clears the old colors with @catppuccin_reset, so -o would keep them forever.
set -gq @thm_bg "{{ background }}"
set -gq @thm_fg "{{ foreground }}"
set -gq @thm_rosewater "{{ mix bright_red bright_foreground 60% }}"
set -gq @thm_flamingo "{{ mix red foreground 50% }}"
set -gq @thm_pink "{{ bright_magenta }}"
set -gq @thm_mauve "{{ magenta }}"
set -gq @thm_red "{{ red }}"
set -gq @thm_maroon "{{ bright_red }}"
set -gq @thm_peach "{{ orange }}"
set -gq @thm_yellow "{{ yellow }}"
set -gq @thm_green "{{ green }}"
set -gq @thm_teal "{{ cyan }}"
set -gq @thm_sky "{{ bright_cyan }}"
set -gq @thm_sapphire "{{ mix blue cyan 50% }}"
set -gq @thm_blue "{{ blue }}"
set -gq @thm_lavender "{{ bright_blue }}"
set -gq @thm_subtext_1 "{{ mix dark_foreground foreground 80% }}"
set -gq @thm_subtext_0 "{{ mix dark_foreground foreground 60% }}"
set -gq @thm_overlay_2 "{{ mix dark_foreground foreground 40% }}"
set -gq @thm_overlay_1 "{{ mix dark_foreground foreground 20% }}"
set -gq @thm_overlay_0 "{{ dark_foreground }}"
set -gq @thm_selection_bg "{{ selection_background }}"
set -gq @thm_selection_fg "{{ selection_foreground }}"
set -gq @thm_surface_2 "{{ muted }}"
set -gq @thm_surface_1 "{{ selection }}"
set -gq @thm_surface_0 "{{ lighter_background }}"
set -gq @thm_mantle "{{ dark_background }}"
set -gq @thm_crust "{{ darker_background }}"
set -gq @thm_accent "{{ accent }}"
