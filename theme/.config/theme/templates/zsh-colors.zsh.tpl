# {{ theme_name }}, generated by hyprdori-theme-set
# Selected text in zsh, same as everywhere else
ZVM_VI_HIGHLIGHT_BACKGROUND='{{ selection_background }}'
ZVM_VI_HIGHLIGHT_FOREGROUND='{{ selection_foreground }}'
zle_highlight=(region:bg={{ selection_background }},fg={{ selection_foreground }} paste:none)
# Up/down history search: the matching text, or the line when nothing matches
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg={{ selection_background }},fg={{ selection_foreground }}'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg={{ red }},bold'
# Command line while typing (zsh-syntax-highlighting; open shells pick up a theme change):
# sudo and the like magenta, commands green, options cyan, other arguments text, paths
# accent, quoted text yellow, redirections (> >> <) dimmed, | && ; dimmed, unknown commands red
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[precommand]='fg={{ magenta }}'
for _style in command builtin alias suffix-alias global-alias function hashed-command; do
    ZSH_HIGHLIGHT_STYLES[$_style]='fg={{ green }}'
done
ZSH_HIGHLIGHT_STYLES[default]='fg={{ foreground }}'
for _style in path path_prefix autodirectory; do
    ZSH_HIGHLIGHT_STYLES[$_style]='fg={{ accent }}'
done
for _style in single-hyphen-option double-hyphen-option; do
    ZSH_HIGHLIGHT_STYLES[$_style]='fg={{ cyan }}'
done
for _style in single-quoted-argument double-quoted-argument dollar-quoted-argument back-quoted-argument \
    single-quoted-argument-unclosed double-quoted-argument-unclosed dollar-quoted-argument-unclosed \
    back-quoted-argument-unclosed; do
    ZSH_HIGHLIGHT_STYLES[$_style]='fg={{ yellow }}'
done
unset _style
ZSH_HIGHLIGHT_STYLES[redirection]='fg={{ dark_foreground }}'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg={{ dark_foreground }}'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{ red }}'
# eza's long listing (file names use LS_COLORS): read yellow, write red, execute green; size
# in the text color; the current user and group yellow, root red, others dimmed; the date dimmed; broken
# link targets red without the underline (bO=0); link names cyan, targets that exist accent. With a theme.yml (the
# icons) eza reads file kinds from here only: folders accent, executables green, every other
# name text (its own colors by file type off: im vi mu lo cr do co tm cm bu sc). Bold comes
# after the color (…;1): with theme.yml eza drops a 24-bit color that has bold in front
_r='{{ yellow.ansi }}' _w='{{ red.ansi }}' _x='{{ green.ansi }}'
export EZA_COLORS="bO=0:ur=${_r}:gr=${_r}:tr=${_r}:uw=${_w}:gw=${_w}:tw=${_w}:ux=${_x}:ue=${_x}:gx=${_x}:tx=${_x}\
:sn={{ foreground.ansi }}:sb={{ dark_foreground.ansi }}:uu={{ yellow.ansi }}:uR={{ red.ansi }}:un={{ dark_foreground.ansi }}\
:gu={{ yellow.ansi }}:gR={{ red.ansi }}:gn={{ dark_foreground.ansi }}:da={{ dark_foreground.ansi }}\
:ln={{ cyan.ansi }};1:lp={{ accent.ansi }}\
:di={{ accent.ansi }};1:ex={{ green.ansi }};1:fi=0:im=0:vi=0:mu=0:lo=0:cr=0:do=0:co=0:tm=0:cm=0:bu=0:sc=0"
unset _r _w _x
