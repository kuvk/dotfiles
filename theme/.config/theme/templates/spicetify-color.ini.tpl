; {{ theme_name }}, generated by hyprdori-theme-set: Spotify's colors (Spicetify's "hyprdori"
; theme, color scheme "hyprdori"), from the theme's palette as the shell uses it
[hyprdori]
; text, and the quieter text beside it
text               = {{ foreground.strip }}
subtext            = {{ dark_foreground.strip }}
; the window, the side panels and the player bar: the background and its darker shades
main               = {{ background.strip }}
main-elevated      = {{ lighter_background.strip }}
sidebar            = {{ dark_background.strip }}
player             = {{ dark_background.strip }}
card               = {{ lighter_background.strip }}
shadow             = {{ darker_background.strip }}
; hover and the selected row
highlight          = {{ lighter_background.strip }}
highlight-elevated = {{ selection.strip }}
selected-row       = {{ foreground.strip }}
; buttons and the active tab in the accent, as everywhere
button             = {{ accent.strip }}
button-active      = {{ accent.strip }}
button-disabled    = {{ muted.strip }}
tab-active         = {{ selection.strip }}
notification       = {{ accent.strip }}
notification-error = {{ red.strip }}
misc               = {{ muted.strip }}
