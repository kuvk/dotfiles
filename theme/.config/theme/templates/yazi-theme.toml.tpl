# {{ theme_name }} — generated by theme-set from templates/yazi-theme.toml.tpl, do not edit
# vim:fileencoding=utf-8:foldmethod=marker

# : Manager {{{

[mgr]
# Syntax highlighting in previews: the bat theme theme-set generates
syntect_theme = "~/.config/bat/themes/Current.tmTheme"

cwd = { fg = "{{ teal }}" }

# Find
find_keyword  = { fg = "{{ yellow }}", bold = true, italic = true, underline = true }
find_position = { fg = "{{ pink }}", bg = "reset", bold = true, italic = true }

# Marker
marker_copied   = { fg = "{{ green }}", bg = "{{ green }}" }
marker_cut      = { fg = "{{ red }}", bg = "{{ red }}" }
marker_marked   = { fg = "{{ teal }}", bg = "{{ teal }}" }
marker_selected = { fg = "{{ yellow }}", bg = "{{ yellow }}" }

# Count
count_copied   = { fg = "{{ base }}", bg = "{{ green }}" }
count_cut      = { fg = "{{ base }}", bg = "{{ red }}" }
count_selected = { fg = "{{ base }}", bg = "{{ yellow }}" }

# Border
border_symbol = "│"
border_style  = { fg = "{{ overlay1 }}" }

# : }}}


# : Tabs {{{

[tabs]
active   = { fg = "{{ base }}", bg = "{{ blue }}", bold = true }
inactive = { fg = "{{ blue }}", bg = "{{ surface0 }}" }

# : }}}


# : Mode {{{

[status]
# Permissions
perm_sep   = { fg = "{{ overlay1 }}" }
perm_type  = { fg = "{{ blue }}" }
perm_read  = { fg = "{{ yellow }}" }
perm_write = { fg = "{{ red }}" }
perm_exec  = { fg = "{{ green }}" }

# Progress
progress_label  = { fg = "#ffffff", bold = true }
progress_normal = { fg = "{{ green }}", bg = "{{ surface1 }}" }
progress_error  = { fg = "{{ yellow }}", bg = "{{ red }}" }

# : }}}


# : Pick {{{

[pick]
border   = { fg = "{{ blue }}" }
active   = { fg = "{{ pink }}", bold = true }
inactive = {}

# : }}}


# : Input {{{

[input]
border   = { fg = "{{ blue }}" }
title    = {}
value    = {}
selected = { reversed = true }

# : }}}


# : Completion {{{

[cmp]
border = { fg = "{{ blue }}" }

# : }}}


# : Tasks {{{

[tasks]
border  = { fg = "{{ blue }}" }
title   = {}
hovered = { fg = "{{ pink }}", bold = true }

# : }}}


# : Which {{{

[which]
# also the text color on the status line bubbles (init.lua)
mask            = { bg = "{{ base }}" }
border          = { fg = "{{ blue }}" }
cand            = { fg = "{{ teal }}" }
rest            = { fg = "{{ overlay2 }}" }
desc            = { fg = "{{ pink }}" }
separator       = "  "
separator_style = { fg = "{{ surface2 }}" }

# : }}}


# : Help {{{

[help]
on      = { fg = "{{ teal }}" }
run     = { fg = "{{ pink }}" }
hovered = { reversed = true, bold = true }
footer  = { fg = "{{ surface0 }}", bg = "{{ text }}" }

# : }}}


# : Spotter {{{

[spot]
border   = { fg = "{{ blue }}" }
title    = { fg = "{{ blue }}" }
tbl_col  = { fg = "{{ teal }}" }
tbl_cell = { fg = "{{ pink }}", bg = "{{ surface1 }}" }

# : }}}


# : Notification {{{

[notify]
title_info  = { fg = "{{ green }}" }
title_warn  = { fg = "{{ yellow }}" }
title_error = { fg = "{{ red }}" }

# : }}}


# : File-specific styles {{{

[app]
overall = { bg = "{{ base }}" }

[mode]

normal_main = { fg = "{{ base }}", bg = "{{ blue }}", bold = true }
normal_alt  = { fg = "{{ blue }}", bg = "{{ base }}"}

# Select mode
select_main = { fg = "{{ base }}", bg = "{{ teal }}", bold = true }
select_alt  = { fg = "{{ teal }}", bg = "{{ surface0 }}" }

# Unset mode
unset_main = { fg = "{{ base }}", bg = "{{ flamingo }}", bold = true }
unset_alt  = { fg = "{{ flamingo }}", bg = "{{ surface0 }}" }

[filetype]
rules = [
	# Image
	{ mime = "**/image/*", fg = "{{ teal }}" },
	# Media
	{ mime = "**/{audio,video}/*", fg = "{{ yellow }}" },
	# Archive
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{ pink }}" },
	# Document
	{ mime = "**/application/{pdf,doc,rtf}", fg = "{{ green }}" },
	# Virtual file system
	{ mime = "vfs/{absent,stale}", fg = "{{ overlay2 }}" },
	# Office Documents
    { mime = "**/application/openxmlformats-officedocument.*", fg = "{{ green }}" },
    { mime = "**/application/oasis.opendocument.*", fg = "{{ green }}" },
    { mime = "**/application/ms-*", fg = "{{ green }}" },
    { mime = "**/application/msword", fg = "{{ green }}" },

	{ url = "*", is = "orphan", fg = "{{ red }}" },
	{ url = "*/", is = "orphan", fg = "{{ red }}" },
	{ url = "*", is = "link", fg = "{{ teal }}" },
	{ url = "*/", is = "link", fg = "{{ teal }}" },
	# Fallback
	{ url = "*", fg = "{{ subtext1 }}" },
	{ url = "*/", fg = "{{ blue }}" },
]

[icon]
dirs = [
	{ name = ".config", text = "", fg = "{{ peach }}" },
	{ name = ".git", text = "", fg = "{{ blue }}" },
	{ name = ".github", text = "", fg = "{{ blue }}" },
	{ name = ".npm", text = "", fg = "{{ blue }}" },
	{ name = "Projects", text = "󰲋", fg = "{{ blue }}" },
	{ name = "projects", text = "󰲋", fg = "{{ blue }}" },
	{ name = "Desktop", text = "", fg = "{{ blue }}" },
	{ name = "Development", text = "", fg = "{{ blue }}" },
	{ name = "Documents", text = "", fg = "{{ blue }}" },
	{ name = "Downloads", text = "", fg = "{{ blue }}" },
	{ name = "Library", text = "", fg = "{{ blue }}" },
	{ name = "Movies", text = "", fg = "{{ blue }}" },
	{ name = "Music", text = "", fg = "{{ blue }}" },
	{ name = "Pictures", text = "", fg = "{{ blue }}" },
	{ name = "Public", text = "", fg = "{{ blue }}" },
	{ name = "Videos", text = "", fg = "{{ blue }}" },
]
conds = [
	# Special files
	{ if = "orphan", text = "󰌺", fg = "{{ red }}" },
	{ if = "link", text = "", fg = "{{ teal }}" },
	{ if = "block", text = "", fg = "{{ flamingo }}" },
	{ if = "char", text = "", fg = "{{ flamingo }}" },
	{ if = "fifo", text = "", fg = "{{ flamingo }}" },
	{ if = "sock", text = "", fg = "{{ flamingo }}" },
	{ if = "sticky", text = "", fg = "{{ flamingo }}" },
	{ if = "dummy", text = "", fg = "{{ red }}" },

	# Fallback
	{ if = "dir", text = "", fg = "{{ blue }}" },
	{ if = "exec", text = "", fg = "{{ green }}" },
	{ if = "!dir", text = "", fg = "{{ subtext1 }}" },
]
