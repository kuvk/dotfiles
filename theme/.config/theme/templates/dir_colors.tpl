BLK 01;{{ accent3.ansi }}
CHR 01;{{ accent3.ansi }}
ORPHAN 01;{{ red.ansi }}
MISSING 01;{{ red.ansi }}
SETUID {{ base.ansi }};{{ red.ansi_bg }}
