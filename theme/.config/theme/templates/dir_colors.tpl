# {{ theme_name }} — generated by theme-set, do not edit
# File colors for ls, eza and zsh completion. dircolors turns this into
# current/ls_colors.zsh, which .zshrc loads. Names are text, like yazi's: folders accent,
# links accent3, executables green, special files below; a file's type shows in its icon
# (eza's theme.yml, the same icons as yazi).
COLORTERM ?*
TERM Eterm
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM *direct*
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*
RESET 0
DIR 01;{{ accent.ansi }}
LINK 01;{{ accent3.ansi }}
MULTIHARDLINK 00
FIFO {{ accent3.ansi }}
SOCK 01;{{ accent2.ansi }}
DOOR 01;{{ accent2.ansi }}
BLK 01;{{ accent3.ansi }}
CHR 01;{{ accent3.ansi }}
ORPHAN 01;{{ red.ansi }}
MISSING 01;{{ red.ansi }}
SETUID {{ base.ansi }};{{ red.ansi_bg }}
SETGID {{ base.ansi }};{{ accent3.ansi_bg }}
CAPABILITY 00
STICKY_OTHER_WRITABLE 01;{{ red.ansi }}
OTHER_WRITABLE 01;{{ accent3.ansi }}
STICKY {{ base.ansi }};{{ accent.ansi_bg }}
EXEC 01;{{ green.ansi }}
*~ {{ overlay0.ansi }}
*# {{ overlay0.ansi }}
