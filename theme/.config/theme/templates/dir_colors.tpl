# {{ theme_name }}, generated by hyprdori-theme-set
# File colors for ls, eza and zsh completion. dircolors turns this into
# current/ls_colors.zsh, which .zshrc loads. Names are text, like yazi's: folders accent,
# links cyan, executables green, special files below; a file's type shows in its icon
# (eza's theme.yml, the same icons as yazi).
COLORTERM ?*
TERM Eterm
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM *direct*
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*
RESET 0
DIR 01;{{ accent.ansi }}
LINK 01;{{ cyan.ansi }}
MULTIHARDLINK 00
FIFO {{ yellow.ansi }}
SOCK 01;{{ magenta.ansi }}
DOOR 01;{{ magenta.ansi }}
BLK 01;{{ yellow.ansi }}
CHR 01;{{ yellow.ansi }}
ORPHAN 01;{{ red.ansi }}
MISSING 01;{{ red.ansi }}
SETUID {{ background.ansi }};{{ red.ansi_bg }}
SETGID {{ background.ansi }};{{ yellow.ansi_bg }}
CAPABILITY 00
STICKY_OTHER_WRITABLE 01;{{ red.ansi }}
OTHER_WRITABLE 01;{{ yellow.ansi }}
STICKY {{ background.ansi }};{{ cyan.ansi_bg }}
EXEC 01;{{ green.ansi }}
*~ {{ dark_foreground.ansi }}
*# {{ dark_foreground.ansi }}
