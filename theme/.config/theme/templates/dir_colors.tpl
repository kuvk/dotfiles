# {{ theme_name }} — generated by theme-set, do not edit
# File colors for ls, eza and zsh completion. dircolors turns this into
# current/ls_colors.zsh, which .zshrc loads.
COLORTERM ?*
TERM Eterm
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM *direct*
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*
RESET 0
DIR 01;{{ accent.ansi }}
LINK 01;{{ accent3.ansi }}
MULTIHARDLINK 00
FIFO {{ accent3.ansi }}
SOCK 01;{{ accent2.ansi }}
