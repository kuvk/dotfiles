# {{ theme_name }}, generated by hyprdori-theme-set
# Colors for KDE apps.
[General]
ColorScheme=Current

[Colors:Window]
BackgroundAlternate={{ dark_background.rgb }}
BackgroundNormal={{ background.rgb }}
DecorationFocus={{ accent.rgb }}
DecorationHover={{ accent.rgb }}
ForegroundActive={{ accent.rgb }}
ForegroundInactive={{ mix.rgb dark_foreground foreground 60% }}
ForegroundLink={{ accent.rgb }}
ForegroundNegative={{ red.rgb }}
ForegroundNeutral={{ yellow.rgb }}
ForegroundNormal={{ foreground.rgb }}
ForegroundPositive={{ green.rgb }}
ForegroundVisited={{ magenta.rgb }}

