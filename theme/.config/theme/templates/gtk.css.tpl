/* {{ theme_name }}, generated by hyprdori-theme-set.
   Loaded by GTK apps on top of the base theme that theme-set picks.
   The names are libadwaita's (GTK4), then GTK3's. */

@define-color accent_color {{ accent }};
@define-color accent_bg_color {{ accent }};
@define-color accent_fg_color {{ background }};
@define-color destructive_color {{ red }};
@define-color destructive_bg_color {{ red }};
@define-color destructive_fg_color {{ background }};
@define-color success_color {{ green }};
@define-color success_bg_color {{ green }};
@define-color success_fg_color {{ background }};
@define-color warning_color {{ yellow }};
@define-color warning_bg_color {{ yellow }};
@define-color warning_fg_color {{ background }};
@define-color error_color {{ red }};
@define-color error_bg_color {{ red }};
@define-color error_fg_color {{ background }};
@define-color window_bg_color {{ background }};
@define-color window_fg_color {{ foreground }};
@define-color view_bg_color {{ background }};
@define-color view_fg_color {{ foreground }};
@define-color headerbar_bg_color {{ dark_background }};
@define-color headerbar_fg_color {{ foreground }};
@define-color headerbar_border_color {{ lighter_background }};
@define-color headerbar_backdrop_color {{ background }};
@define-color headerbar_shade_color {{ darker_background }};
@define-color sidebar_bg_color {{ dark_background }};
@define-color sidebar_fg_color {{ foreground }};
@define-color sidebar_backdrop_color {{ dark_background }};
@define-color sidebar_shade_color {{ darker_background }};
@define-color secondary_sidebar_bg_color {{ dark_background }};
@define-color secondary_sidebar_fg_color {{ foreground }};
@define-color secondary_sidebar_backdrop_color {{ dark_background }};
@define-color secondary_sidebar_shade_color {{ darker_background }};
@define-color card_bg_color {{ lighter_background }};
@define-color card_fg_color {{ foreground }};
@define-color card_shade_color {{ darker_background }};
@define-color thumbnail_bg_color {{ lighter_background }};
@define-color thumbnail_fg_color {{ foreground }};
@define-color dialog_bg_color {{ background }};
@define-color dialog_fg_color {{ foreground }};
@define-color popover_bg_color {{ lighter_background }};
@define-color popover_fg_color {{ foreground }};
@define-color popover_shade_color {{ darker_background }};
@define-color shade_color {{ darker_background }};
@define-color scrollbar_outline_color {{ selection }};

@define-color theme_bg_color {{ background }};
@define-color theme_fg_color {{ foreground }};
@define-color theme_base_color {{ background }};
@define-color theme_text_color {{ foreground }};
@define-color theme_selected_bg_color {{ accent }};
@define-color theme_selected_fg_color {{ background }};
@define-color insensitive_fg_color {{ dark_foreground }};
@define-color insensitive_bg_color {{ lighter_background }};
@define-color borders {{ selection }};
@define-color unfocused_borders {{ lighter_background }};

selection {
  background-color: {{ selection_background }};
  color: {{ selection_foreground }};
}

/* Hyprland rounds windows itself, so they match its corners, square in Work-Game too */
window,
window.csd,
window.background,
window.messagedialog,
dialog-host,
dialog > .background {
  border-radius: 0;
}

/* The only window button is close (Settings > Style > Window buttons), drawn like the shell's:
   a bare X that turns the accent color on hover. headerbar is GTK3, windowcontrols GTK4 */
headerbar button.titlebutton.close,
.titlebar button.titlebutton.close,
windowcontrols > button.close,
windowcontrols > button.close > image {
  background: none;
  border: none;
  box-shadow: none;
  color: {{ mix dark_foreground foreground 60% }};
}

headerbar button.titlebutton.close:hover,
.titlebar button.titlebutton.close:hover,
windowcontrols > button.close:hover,
windowcontrols > button.close:hover > image {
  background: none;
  box-shadow: none;
  color: {{ accent }};
}

/* Main dialog buttons (OK, Open): a clearer hover, and readable while disabled */
button.suggested-action {
  background-color: shade({{ accent }}, 0.6);
  background-image: none;
  color: {{ mix dark_foreground foreground 60% }};
}

button.suggested-action:hover {
  background-color: shade({{ accent }}, 0.8);
  background-image: none;
  color: {{ foreground }};
}

button.suggested-action:active {
  background-color: shade({{ accent }}, 0.6);
  background-image: none;
  color: {{ foreground }};
}

button.suggested-action:disabled {
  background-color: shade({{ accent }}, 0.2);
  background-image: none;
  color: {{ foreground }};
  opacity: 1;
}

button.suggested-action:disabled > label {
  color: {{ foreground }};
  opacity: 1;
}
