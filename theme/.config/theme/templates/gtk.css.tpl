/* {{ theme_name }} — generated by theme-set, do not edit.
   Loaded by GTK apps on top of the base theme that theme-set picks.
   The names are libadwaita's (GTK4), then GTK3's. */

@define-color accent_color {{ accent }};
@define-color accent_bg_color {{ accent }};
@define-color accent_fg_color {{ base }};
@define-color destructive_color {{ red }};
@define-color destructive_bg_color {{ red }};
@define-color destructive_fg_color {{ base }};
@define-color success_color {{ green }};
@define-color success_bg_color {{ green }};
@define-color success_fg_color {{ base }};
@define-color warning_color {{ yellow }};
@define-color warning_bg_color {{ yellow }};
@define-color warning_fg_color {{ base }};
@define-color error_color {{ red }};
@define-color error_bg_color {{ red }};
@define-color error_fg_color {{ base }};
@define-color window_bg_color {{ base }};
@define-color window_fg_color {{ text }};
@define-color view_bg_color {{ base }};
@define-color view_fg_color {{ text }};
@define-color headerbar_bg_color {{ mantle }};
@define-color headerbar_fg_color {{ text }};
@define-color headerbar_border_color {{ surface0 }};
@define-color headerbar_backdrop_color {{ base }};
@define-color headerbar_shade_color {{ crust }};
@define-color sidebar_bg_color {{ mantle }};
@define-color sidebar_fg_color {{ text }};
@define-color sidebar_backdrop_color {{ mantle }};
@define-color sidebar_shade_color {{ crust }};
@define-color secondary_sidebar_bg_color {{ mantle }};
@define-color secondary_sidebar_fg_color {{ text }};
@define-color secondary_sidebar_backdrop_color {{ mantle }};
@define-color secondary_sidebar_shade_color {{ crust }};
@define-color card_bg_color {{ surface0 }};
@define-color card_fg_color {{ text }};
@define-color card_shade_color {{ crust }};
@define-color thumbnail_bg_color {{ surface0 }};
@define-color thumbnail_fg_color {{ text }};
@define-color dialog_bg_color {{ base }};
@define-color dialog_fg_color {{ text }};
@define-color popover_bg_color {{ surface0 }};
@define-color popover_fg_color {{ text }};
@define-color popover_shade_color {{ crust }};
@define-color shade_color {{ crust }};
@define-color scrollbar_outline_color {{ surface1 }};

@define-color theme_bg_color {{ base }};
@define-color theme_fg_color {{ text }};
@define-color theme_base_color {{ base }};
@define-color theme_text_color {{ text }};
@define-color theme_selected_bg_color {{ accent }};
