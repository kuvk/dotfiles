/* {{ theme_name }}, generated by hyprdori-theme-set: Spotify's look beyond its colors (Spicetify's
   "hyprdori" theme): the scrollbars and text selection in the theme's colors */
::-webkit-scrollbar-thumb {
    background-color: {{ selection }} !important;
}
::selection {
    background-color: {{ selection }};
    color: {{ foreground }};
}
