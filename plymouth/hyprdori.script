# Hyprdori's Plymouth theme. Adapted from Omarchy's (https://github.com/basecamp/omarchy, MIT,
# Copyright (c) David Heinemeier Hansson). install.sh fills in the @COLORS@ and draws the images.

Window.SetBackgroundTopColor(@BG_RGB@);
Window.SetBackgroundBottomColor(@BG_RGB@);

logo.original_image = Image("logo.png");
logo.image = logo.original_image;
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(1);

# The text logo, at the bottom
words.original_image = Image("text.png");
words.image = words.original_image;
words.sprite = Sprite(words.image);
words.sprite.SetOpacity(1);

# Use these to adjust the progress bar timing
global.fake_progress_limit = 1; # Target percentage for fake progress (0.0 to 1.0)
global.fake_progress_duration = 15.0;  # Duration in seconds to reach limit

# Progress bar animation variables
global.animation_frame = 0;
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;  # Track when fake progress started
global.password_shown = 0;  # Track if password dialog has been shown
global.password_sent = 0;  # A password was entered; asked again means it was wrong
global.wrong_count = 0;  # Wrong passwords so far
global.farewell = 0;  # The farewell screen is up; nothing else draws
global.checking_frame = -1;  # Frame a password was entered on, while it's being checked
global.max_progress = 0.0;  # Track the maximum progress reached to prevent backwards movement

# Window size the sprites were last laid out for
global.layout_width = 0;
global.layout_height = 0;

fun refresh_callback() {
  # Displays can show up after this script ran, e.g. a Thunderbolt monitor
  # whose DisplayPort tunnel comes up after plymouthd started. The window
  # grows to the largest display, so re-center everything when it changes.
  if (Window.GetWidth() != global.layout_width || Window.GetHeight() != global.layout_height) {
    layout();
  }

  global.animation_frame++;

  # A password has been checked for 3 seconds with no answer either way: show the progress
  if (global.checking_frame >= 0 && global.animation_frame - global.checking_frame > 150) {
    start_boot_progress();
  }

  # Animate fake progress to limit over time with easing
  if (global.fake_progress_active == 1) {
    # Calculate elapsed time since start
    elapsed_time = global.animation_frame / 50.0;  # Convert frames to seconds (50 FPS)

    # Calculate linear progress ratio (0 to 1) based on time
    time_ratio = elapsed_time / global.fake_progress_duration;
    if (time_ratio > 1.0) time_ratio = 1.0;

    # Apply easing curve: ease-out quadratic
    # Formula: 1 - (1 - x)^2
    eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));

    # Calculate fake progress based on eased ratio
    global.fake_progress = eased_ratio * global.fake_progress_limit;

    # Update progress bar with fake progress
    update_progress_bar(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Helper Functions --------------------------------

# The bar's two ends at its start and end, the middle stretched between them: at least both ends
fun draw_progress_bar() {
  ends = progress_left.image.GetWidth() + progress_right.image.GetWidth();
  width = Math.Int(progress_box.image.GetWidth() * global.max_progress);
  if (width < ends) width = ends;
  middle = width - ends;
  progress_left.sprite.SetPosition(progress_box.x, progress_box.y, 1);
  progress_middle.sprite.SetPosition(progress_box.x + progress_left.image.GetWidth(), progress_box.y, 1);
  progress_right.sprite.SetPosition(progress_box.x + width - progress_right.image.GetWidth(), progress_box.y, 1);
  if (middle >= 1) {
    progress_middle.sprite.SetImage(progress_middle.original_image.Scale(middle, progress_middle.original_image.GetHeight()));
    progress_middle.shown = 1;
  } else {
    progress_middle.shown = 0;
  }
  if (global.progress_shown == 1) progress_middle.sprite.SetOpacity(progress_middle.shown);
}

fun update_progress_bar(progress) {
  # Only update if progress is moving forward
  if (progress > global.max_progress) {
    global.max_progress = progress;
    draw_progress_bar();
  }
}

fun show_progress_bar() {
  global.progress_shown = 1;
  progress_box.sprite.SetOpacity(1);
  progress_left.sprite.SetOpacity(1);
  progress_right.sprite.SetOpacity(1);
  progress_middle.sprite.SetOpacity(progress_middle.shown);
}

fun hide_progress_bar() {
  global.progress_shown = 0;
  progress_box.sprite.SetOpacity(0);
  progress_left.sprite.SetOpacity(0);
  progress_right.sprite.SetOpacity(0);
  progress_middle.sprite.SetOpacity(0);
}

fun show_password_dialog() {
  hint.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  hint.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

fun start_fake_progress() {
  global.fake_progress_active = 1;

  # Reset fake progress
  global.animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start_time = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

#----------------------------------------- Dialogue --------------------------------

entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.sprite.SetOpacity(0);

# Hint under the password field
hint.image = Image("hint.png");
wrong1.image = Image("wrong1.png");
wrong2.image = Image("wrong2.png");
hint.sprite = Sprite(hint.image);
hint.sprite.SetOpacity(0);

# The line under the field: the hint, or "wrong password" after a failed try
fun set_hint(image) {
  hint.sprite.SetImage(image);
  hint.sprite.SetX(global.layout_width / 2 - image.GetWidth() / 2);
}

# Bullet array
bullet.sprites = [];
global.bullet_count = 0;

# Dots are 9px with 4px gaps, centered in the field as a group, as on the lock and login screens
bullet.size = 9;
bullet.gap = 4;

fun position_bullet(index) {
  row_width = global.bullet_count * (bullet.size + bullet.gap) - bullet.gap;
  x = entry.x + entry.image.GetWidth() / 2 - row_width / 2 + index * (bullet.size + bullet.gap);
  bullet.sprites[index].SetPosition(x, entry.y + entry.image.GetHeight() / 2 - bullet.size / 2, 10002);
}

fun display_normal_callback() {
  if (global.farewell == 1) return;
  if (global.password_shown == 1) {
    # A password was entered. Keep the field up while it's checked, so a wrong one doesn't
    # flash the progress bar; the bar comes when the boot moves on (update_status_callback).
    global.password_sent = 1;
    global.checking_frame = global.animation_frame;
    return;
  }
  hide_password_dialog();
}

fun start_boot_progress() {
  global.checking_frame = -1;
  if (global.farewell == 1) return;
  hide_password_dialog();

  # Only show progress bar for boot and resume modes
  mode = Plymouth.GetMode();
  if (mode == "boot" || mode == "resume") {
    show_progress_bar();
    start_fake_progress();
  }
}

# systemd reports units starting: after a password, the boot carries on. Wait a moment
# (15 frames) before showing the progress: when the drives failed to unlock, the unit
# starting is luks-poweroff, and its farewell message arrives right after.
fun update_status_callback(status) {
  if (global.farewell == 0 && global.checking_frame >= 0) {
    global.checking_frame = global.animation_frame - 150 + 15;
  }
}

Plymouth.SetUpdateStatusFunction(update_status_callback);

fun display_password_callback(prompt, bullets) {
  if (global.farewell == 1) return;
  global.checking_frame = -1;
  global.password_shown = 1;  # Mark that password dialog has been shown

  # Asked again after a password was entered: it was wrong. A different line for each try;
  # the last failure powers off (luks-poweroff), shown by display_message_callback.
  if (global.password_sent == 1 && bullets == 0) {
    global.password_sent = 0;
    global.wrong_count++;
    if (global.wrong_count == 1) {
      set_hint(wrong1.image);
    } else {
      set_hint(wrong2.image);
    }
  }

  # Stop fake progress when password dialog appears
  stop_fake_progress();
  hide_progress_bar();
  show_password_dialog();

  # Clear all bullets first
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  # Create and show bullets for current password, as many as fit in the field
  max_bullets = Math.Int((entry.image.GetWidth() - 40) / (bullet.size + bullet.gap));
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }

  global.bullet_count = bullets_to_show;
  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      # The bullet image drawn large, scaled down to the dot size
      bullet.sprites[index] = Sprite(bullet.image.Scale(bullet.size, bullet.size));
    }

    position_bullet(index);
    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Progress Bar --------------------------------

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetOpacity(0);

progress_left.image = Image("progress_left.png");
progress_left.sprite = Sprite(progress_left.image);
progress_left.sprite.SetOpacity(0);
progress_right.image = Image("progress_right.png");
progress_right.sprite = Sprite(progress_right.image);
progress_right.sprite.SetOpacity(0);
progress_middle.original_image = Image("progress_middle.png");
progress_middle.sprite = Sprite();
progress_middle.sprite.SetOpacity(0);
progress_middle.shown = 0;
global.progress_shown = 0;

fun progress_callback(duration, progress) {
  # Track when fake progress starts
  # Needed because duration and progress freeze during drive decryption
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }

  global.real_progress = progress;

  # Use real progress once its unfrozen and exceeds fake progress
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Layout --------------------------------

# A copy of an image at most max_width by max_height, the same shape; the image itself if it fits
fun fit_image(image, max_width, max_height) {
  ratio = 1;
  if (image.GetWidth() > max_width) ratio = max_width / image.GetWidth();
  if (image.GetHeight() * ratio > max_height) ratio = max_height / image.GetHeight();
  if (ratio >= 1) return image;
  if (ratio <= 0) ratio = 0.01;
  return image.Scale(Math.Int(image.GetWidth() * ratio), Math.Int(image.GetHeight() * ratio));
}

# The field (and the progress bar in its place) centered, the logo 40 px above it, the text logo
# 60 px from the bottom; either drawn smaller where the window is too small for it
fun layout() {
  global.layout_width = Window.GetWidth();
  global.layout_height = Window.GetHeight();

  entry.x = global.layout_width / 2 - entry.image.GetWidth() / 2;
  entry.y = global.layout_height / 2 - entry.image.GetHeight() / 2;
  entry.sprite.SetPosition(entry.x, entry.y, 10001);

  logo.image = fit_image(logo.original_image, global.layout_width * 0.8, entry.y - 40 - 40);
  logo.sprite.SetImage(logo.image);
  logo.sprite.SetX(global.layout_width / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(entry.y - 40 - logo.image.GetHeight());

  # below the hint (16 px under the field, about 20 high) with 40 px to spare
  words_room = global.layout_height - 60 - (entry.y + entry.image.GetHeight() + 16 + 20 + 40);
  words.image = fit_image(words.original_image, global.layout_width * 0.8, words_room);
  words.sprite.SetImage(words.image);
  words.sprite.SetX(global.layout_width / 2 - words.image.GetWidth() / 2);
  words.sprite.SetY(global.layout_height - 60 - words.image.GetHeight());

  hint.x = global.layout_width / 2 - hint.image.GetWidth() / 2;
  hint.y = entry.y + entry.image.GetHeight() + 16;
  hint.sprite.SetPosition(hint.x, hint.y, 10001);

  for (index = 0; bullet.sprites[index]; index++) {
    position_bullet(index);
  }

  progress_box.x = global.layout_width / 2 - progress_box.image.GetWidth() / 2;
  progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
  progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

  draw_progress_bar();

  if (global.farewell == 1) {
    position_farewell();
  }
}

layout();

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

# Farewell before luks-poweroff turns the machine off: everything else goes, and one large
# line stays in the middle of the plain background, drawn with the hint's sprite.
farewell_line.image = Image("farewell.png");

fun position_farewell() {
  hint.sprite.SetX(Window.GetWidth() / 2 - farewell_line.image.GetWidth() / 2);
  hint.sprite.SetY(Window.GetHeight() / 2 - farewell_line.image.GetHeight() / 2);
}

fun show_farewell() {
  global.farewell = 1;
  global.checking_frame = -1;
  stop_fake_progress();
  hide_progress_bar();
  hide_password_dialog();
  message_sprite.SetOpacity(0);
  logo.sprite.SetOpacity(0);
  words.sprite.SetOpacity(0);
  hint.sprite.SetImage(farewell_line.image);
  position_farewell();
  hint.sprite.SetOpacity(1);
}

# luks-poweroff sends "hyprdori-farewell" when the drives didn't unlock
fun display_message_callback(text) {
  if (text == "hyprdori-farewell") {
    show_farewell();
    return;
  }
  if (global.farewell == 1) return;
  message = Image.Text(text, @TEXT_RGB@);
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

#----------------------------------------- No password --------------------------------

# Drives that aren't encrypted (install.sh fills this in from the initramfs hooks): nothing
# asks for a password, so the boot shows the progress bar from the start
if (@ENCRYPTED@ == 0) {
  start_boot_progress();
}

#----------------------------------------- Shutdown --------------------------------

# Shutdown and reboot: the logos with the progress bar from the start, filling in a few seconds
if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot") {
  global.fake_progress_limit = 1.0;
  global.fake_progress_duration = 4.0;
  show_progress_bar();
  start_fake_progress();
}
