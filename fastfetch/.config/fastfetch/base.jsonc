// Inspired by Catnap
// Colors from the system theme: theme-set.py renders this file into
// ~/.config/fastfetch/config.jsonc (a theme slot name plus ".ansi" in double
// braces is its 24-bit color code).
// Edit this file, not config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/theme/logo/ascii-dori",
    "type": "auto",
    "width": 12,
    "padding": {
      "top": 3,
      "right": 3,
      "left": 3,
			"bottom": 2,
    },
    "color": {
      "1": "{{ accent2.ansi }}",
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "{{ overlay1.ansi }}",
      "output": "{{ accent3.ansi }}",
    },
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#{{ accent.ansi }}}{icon}  distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰅐  uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󱦟  os age  {#keys}│",
      "type": "command",
      "text": "printf \"%s days\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\"",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  pkgs    {#keys}│",
      "type": "packages",
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰇅  pc      {#keys}│",
      "type": "host",
      "format": "{1}",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰍛  cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      // one line per kind; a line with no such GPU (a desktop without one) doesn't show
      "key": "│ {#{{ accent.ansi }}}󰢮  dgpu    {#keys}│",
      "type": "gpu",
      "hideType": "integrated",
      "format": "{name}",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰢮  igpu    {#keys}│",
      "type": "gpu",
      "hideType": "discrete",
      "format": "{name}",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰓡  swap    {#keys}│",
      "type": "swap",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  root    {#keys}│",
      "type": "disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󱂶  home    {#keys}│",
      "type": "disk",
      "folders": "/home",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰏘  theme   {#keys}│",
      "type": "command",
      "text": "jq -r .name ~/.config/theme/current/quickshell.json",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰀻  icons   {#keys}│",
      "type": "command",
      "text": "gsettings get org.gnome.desktop.interface icon-theme | tr -d \"'\"",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰊁  font    {#keys}│",
      "type": "command",
      "text": "f=$(gsettings get org.gnome.desktop.interface font-name | tr -d \\'); m=$(gsettings get org.gnome.desktop.interface monospace-font-name | tr -d \\'); [ \"${f% *}\" = \"${m% *}\" ] && echo \"${f% *}\" || echo \"${f% *}, ${m% *}\"",
    },
    {
      "key": "│ {#{{ accent.ansi }}}󰆿  cursor  {#keys}│",
      "type": "cursor",
      "format": "{theme} ({size}px)",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#{{ accent.ansi }}}  shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "╰────────────╯",
      "type": "custom",
    },
  ],
}
