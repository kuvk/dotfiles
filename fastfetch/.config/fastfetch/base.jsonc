// Inspired by Catnap
// Colors from the system theme: theme-set.py renders this file into
// ~/.config/fastfetch/config.jsonc (a theme slot name plus ".ansi" in double
// braces is its 24-bit color code).
// Edit this file, not config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/fastfetch-logo.txt",
    "type": "auto",
    "width": 12,
    "padding": {
      "top": 4,
      "right": 0,
      "left": 3,
    },
    "color": {
      "1": "{{ accent.ansi }}",
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "{{ overlay1.ansi }}",
      "output": "{{ text.ansi }}",
    },
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󰇅  hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "type": "command",
      "key": "│ {#{{ accent2.ansi }}}󱦟  os age  {#keys}│",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\"",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󰅐  uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󰇅  pc      {#keys}│",
      "type": "host",
      "format": "{1}",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󰍛  cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󰍛  gpu     {#keys}│",
      "type": "gpu",
      "format": "{2} ({6})",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  root    {#keys}│",
      "type": "disk",
      "folders": "/",
			"format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󱂶  home    {#keys}│",
      "type": "disk",
      "folders": "/home",
			"format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}{icon}  distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}󰇄  desktop {#keys}│",
      "type": "de",
			"format": "{pretty-name}"
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  pkgs    {#keys}│",
      "type": "packages",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#{{ accent2.ansi }}}  colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰────────────╯",
      "type": "custom",
    },
  ],
}
