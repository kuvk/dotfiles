// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/fastfetch-logo.txt",
    "type": "auto",
    "width": 12,
    "padding": {
      "top": 4,
      "right": 0,
      "left": 3,
    },
    "color": {
      "1": "magenta",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#34}  user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#34}󰇅  hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "type": "command",
      "key": "│ {#34}󱦟  os age  {#keys}│",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\"",
    },
    {
      "key": "│ {#34}󰅐  uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#34}󰇅  pc      {#keys}│",
      "type": "host",
      "format": "{1}",
    },
    {
      "key": "│ {#34}󰍛  cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#34}󰍛  gpu     {#keys}│",
      "type": "gpu",
      "format": "{2} ({6})",
    },
    {
      "key": "│ {#34}  memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "│ {#34}  root    {#keys}│",
      "type": "disk",
      "folders": "/",
			"format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "key": "│ {#34}󱂶  home    {#keys}│",
      "type": "disk",
      "folders": "/home",
			"format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "key": "├────────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#34}{icon}  distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#34}  kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#34}  wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#34}󰇄  desktop {#keys}│",
      "type": "de",
			"format": "{pretty-name}"
    },
    {
      "key": "│ {#34}  pkgs    {#keys}│",
      "type": "packages",
    },
    {
      "key": "│ {#34}  term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#34}  shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#34}  colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰────────────╯",
      "type": "custom",
    },
  ],
}
