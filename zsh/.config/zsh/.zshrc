case "$OSTYPE" in
    darwin*) _OS="Darwin" ;;
    linux*)  _OS="Linux" ;;
    *)       _OS="$(uname)" ;;
esac

## PATH, first, so everything below finds its tools
typeset -U path
path=(
    $HOME/.local/bin
    $HOME/.tmux/plugins/tmuxifier/bin
    $HOME/.spicetify
    $HOME/.config/spicetify
    $HOME/.pyenv/shims
    $HOME/.pyenv/bin
    $HOME/.cargo/bin
    $path
)
path=(${^path}(N-/))

## Init scripts of tools are cached, and only regenerated when the tool updates:
## running them on every start is most of a shell's startup time
_zsh_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_zsh_cache ]] || mkdir -p $_zsh_cache

# _cached_init NAME COMMAND [ARGS...]: writes $_zsh_cache/NAME.zsh if needed
_cached_init() {
    local file=$_zsh_cache/$1.zsh bin=${commands[$2]}
    shift
    [[ -n $bin ]] || return 1
    if [[ ! -s $file || $bin -nt $file ]]; then
        "$@" >$file
        zcompile $file
    fi
}
_cached_source() {
    _cached_init "$@" && source $_zsh_cache/$1.zsh
}

# Compile a file on first use and when it changes; zsh loads the compiled form
_compiled() {
    [[ $1.zwc -nt $1 ]] || zcompile $1 2>/dev/null
    [[ -n $2 ]] || source $1
}
_compiled $ZDOTDIR/.zshrc nosource

## File colors from the theme (theme-set.py writes them; see TRAPUSR1 below)
_ls_colors=$HOME/.config/theme/current/ls_colors.zsh
_load_ls_colors() {
    [[ -r $_ls_colors ]] && source $_ls_colors
    [[ -r $_ls_colors:h/zsh-colors.zsh ]] && source $_ls_colors:h/zsh-colors.zsh
    zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
}
_load_ls_colors

## Starship
if command -v starship >/dev/null; then
    export STARSHIP_LOG=error
    if [[ "$_OS" == "Darwin" ]]; then
        # no theme-set on macOS: use the base config directly
        export STARSHIP_CONFIG=~/.config/starship/base.toml
    fi
    _cached_source starship starship init zsh --print-full-init

    # theme-set.py redraws the prompt in every open shell after a theme
    # switch (and reloads the file colors): each interactive shell registers its pid, and USR1 (sent only
    # to registered shells) re-renders the prompt with the new colors
    _prompt_dir="${XDG_RUNTIME_DIR:-/tmp}/zsh-prompt"
    [[ -d $_prompt_dir ]] || mkdir -p "$_prompt_dir"
    : >"$_prompt_dir/$$"
    TRAPUSR1() { _load_ls_colors; zle && zle reset-prompt; }
    _prompt_unregister() { rm -f "$_prompt_dir/$$"; }
    autoload -Uz add-zsh-hook && add-zsh-hook zshexit _prompt_unregister
fi

## fzf: preview in the file picker (Ctrl+T), without touching piped uses of fzf
export FZF_CTRL_T_OPTS="--preview '[[ -d {} ]] && eza -1 --color=always --icons=always {} || bat --color=always --style=plain,header,grid {}'"

## Claude Code: the terminal's own cursor, so it matches the rest of the terminal
export CLAUDE_CODE_NATIVE_CURSOR=1

## bat: the theme generated by theme-set.py (also set in bat's config file;
## the variable wins over any other config bat may find)
export BAT_THEME="Current"

## Options / history
setopt NOBEEP
setopt inc_append_history
setopt extended_history
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt interactive_comments
setopt auto_cd

HISTSIZE=100000
SAVEHIST=100000
# Outside the dotfiles repo. A shell still open from before the move keeps
# writing to the old file, so whatever lands there is merged in.
HISTFILE=${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
if [[ -f $ZDOTDIR/.zsh_history ]]; then
    command cat $ZDOTDIR/.zsh_history >>$HISTFILE && command rm $ZDOTDIR/.zsh_history
fi

## Completions
fpath=($HOME/.local/share/zsh-plugins/zsh-completions/src $fpath)

autoload -Uz compinit
zmodload zsh/complist

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# Full check once a day, otherwise trust the cached dump
ZCOMPDUMP=$_zsh_cache/zcompdump-$ZSH_VERSION
_fresh_dump=($ZCOMPDUMP(N.mh-24))
if (( $#_fresh_dump )); then
    compinit -C -d $ZCOMPDUMP
else
    compinit -d $ZCOMPDUMP
    touch $ZCOMPDUMP
fi
unset _fresh_dump
_compiled $ZCOMPDUMP nosource

_comp_options+=(globdots)

## ZSH VI MODE
zvm_config() {
    # y, yy, d and friends also go to the system clipboard
    ZVM_SYSTEM_CLIPBOARD_ENABLED=true
    ZVM_INSERT_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BEAM
    ZVM_NORMAL_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
    ZVM_OPPEND_MODE_CURSOR=$ZVM_CURSOR_BLINKING_UNDERLINE
    ZVM_VISUAL_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
    ZVM_VISUAL_LINE_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
    ZVM_VI_INSERT_ESCAPE_BINDKEY=jk
}
_compiled $HOME/.local/share/zsh-plugins/zsh-vi-mode/zsh-vi-mode.zsh

# p and P paste the system clipboard, like everywhere else
_clipboard_to_cutbuffer() {
    local content
    content=$(zvm_clipboard_get) && [[ -n $content ]] && CUTBUFFER=$content
}
functions[_zvm_put_after]=$functions[zvm_vi_put_after]
functions[_zvm_put_before]=$functions[zvm_vi_put_before]
functions[_zvm_replace_selection]=$functions[zvm_vi_replace_selection]
# (the plugin also highlights what it pasted; only the spaces show, as syntax
# highlighting recolors the rest, so that's cleared)
zvm_vi_put_after() { _clipboard_to_cutbuffer; _zvm_put_after "$@"; zvm_highlight clear; }
zvm_vi_put_before() { _clipboard_to_cutbuffer; _zvm_put_before "$@"; zvm_highlight clear; }
zvm_vi_replace_selection() { _clipboard_to_cutbuffer; _zvm_replace_selection "$@"; }

# zsh-vi-mode sets its keys at the first prompt, over anything bound before it,
# so these run after it: history search and fzf's keys. (Generated out here: the
# plugin runs this hook with its own local $commands, hiding zsh's.)
_cached_init fzf fzf --zsh
zvm_after_init() {
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
    [[ -r $_zsh_cache/fzf.zsh ]] && source $_zsh_cache/fzf.zsh
}
# Normal-mode keys are set later still, on first use
zvm_after_lazy_keybindings() {
    bindkey -M vicmd 'k' history-substring-search-up
    bindkey -M vicmd 'j' history-substring-search-down
}

# HISTORY AND AUTOSUGGESTIONS
_compiled $HOME/.local/share/zsh-plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
_compiled $HOME/.local/share/zsh-plugins/zsh-history-substring-search/zsh-history-substring-search.zsh

# Directory tools
_cached_source direnv direnv hook zsh
_cached_source zoxide zoxide init zsh

# Tmuxifier and pyenv: shims and scripts are on PATH; their shell functions
# (load-session, pyenv shell) load the first time they're used
if [[ -d "$HOME/.tmux/plugins/tmuxifier" ]]; then
    export TMUXIFIER_LAYOUT_PATH="$HOME/.tmux-layouts"
    tmuxifier() {
        unfunction tmuxifier
        eval "$(command tmuxifier init -)"
        tmuxifier "$@"
    }
    alias tnew="tmuxifier new-session"
    alias tedit="tmuxifier edit-session"
    alias tload="tmuxifier load-session"
fi

if [[ -d "$HOME/.pyenv" ]]; then
    export PYENV_ROOT="$HOME/.pyenv"
    pyenv() {
        unfunction pyenv
        eval "$(command pyenv init -)"
        pyenv "$@"
    }
fi

# ALIASES
alias cd="z"
alias cdi="zi"
alias ll="eza -lAh --group-directories-first --git --icons=always"
alias l="eza -lh  --group-directories-first --git --icons=always"
alias ls="eza --group-directories-first --icons=always"
alias cat="bat --style=plain,header,grid"
alias dots="z \"$HOME/dotfiles\""

# yazi that follows theme changes (yazi-live.sh); on quit, the shell moves to
# yazi's last folder
y() {
    local tmp
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    YAZI_LIVE_CWD_OUT="$tmp" ~/.config/scripts/yazi-live.sh "$@"
    local cwd
    cwd="$(command cat -- "$tmp" 2>/dev/null)"
    [[ -n $cwd && $cwd != "$PWD" ]] && builtin cd -- "$cwd"
    command rm -f -- "$tmp"
}
alias top="btop"
alias nv="nvim"
alias ta="tmux attach"
alias td="tmux detach"
alias ip="ip --color=auto"
alias grep="grep --color=auto"
alias diff="diff --color=auto"
alias paccheck="pacman -Qq | fzf --preview 'pacman -Qil {}' --layout=reverse --bind 'enter:execute(pacman -Qil {} | less)'"

if [[ "$TERM" = "xterm-kitty" ]]; then
    alias ssh="TERM=xterm-256color ssh"
fi

# Syntax highlighting
_compiled $HOME/.local/share/zsh-plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
(( ${+ZSH_HIGHLIGHT_STYLES} )) || typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[path]=fg=blue
ZSH_HIGHLIGHT_STYLES[path_prefix]=fg=blue
ZSH_HIGHLIGHT_STYLES[autodirectory]=fg=blue
ZSH_HIGHLIGHT_STYLES[precommand]=fg=magenta
ZSH_HIGHLIGHT_STYLES[alias]=fg=green
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]=fg=cyan
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]=fg=cyan
ZSH_HIGHLIGHT_STYLES[redirection]=fg=yellow
ZSH_HIGHLIGHT_STYLES[commandseparator]=fg=yellow
ZSH_HIGHLIGHT_STYLES[unknown-token]=fg=red

# if [[ -o interactive ]]; then
#     fastfetch
# fi
